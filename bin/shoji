def render_folders(t, dark):
    """Icon theme "Shoji": our own paper folders, everything else inherited from Papirus.

    Original artwork (MIT) with Lucide glyphs, so it ships with the theme and needs no
    particular Papirus folder color installed."""
    import shutil
    if ICON_THEME.exists():
        shutil.rmtree(ICON_THEME)
    out = ICON_THEME / "scalable/places"
    out.mkdir(parents=True)
    front = mix(t["accent"], t["text"], 0.12)
    back = mix(front, t["base"], 0.30)
    paper = t["text"] if dark else "#ffffff"
    ink = t["on_accent"]
    for name, glyph in FOLDER_ICONS.items():
        mark = ""
        if glyph:
            mark = (f'<g transform="translate(20 28)" fill="none" stroke="{ink}" stroke-width="2.1" '
                    f'stroke-linecap="round" stroke-linejoin="round">{FOLDER_GLYPHS[glyph]}</g>')
        svg = ('<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">'
               f'<path d="M5 14a5 5 0 0 1 5-5h13.5a3 3 0 0 1 2.1.9L30 14h24a5 5 0 0 1 5 5v31H5z" fill="{back}"/>'
               f'<rect x="10" y="17" width="44" height="18" rx="2" fill="{paper}" opacity="0.92"/>'
               f'<rect x="4" y="22" width="56" height="35" rx="5" fill="{front}"/>'
               f'{mark}</svg>')
        (out / f"{name}.svg").write_text(svg)
    inherits = "Papirus-Dark" if dark else "Papirus"
    if not any((Path(d) / "icons" / inherits).exists() for d in (HOME / ".local/share", "/usr/local/share", "/usr/share")):
        inherits = "Adwaita"
    (ICON_THEME / "index.theme").write_text(
        "[Icon Theme]\nName=Shoji\nComment=Paper folders in the Shoji palette\n"
        f"Inherits={inherits},hicolor\nDirectories=scalable/places\n\n"
        "[scalable/places]\nSize=64\nContext=Places\nType=Scalable\nMinSize=16\nMaxSize=512\n")
    run("gtk-update-icon-cache", "-f", "-q", str(ICON_THEME))


def gnome_reset():
    """GNOME session: Catppuccin Mocha GTK like before Shoji."""
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", GNOME_GTK)
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark")
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Papirus-Dark")
    run("gsettings", "set", "org.gnome.desktop.interface", "font-name", "Cantarell 11")
    run("gsettings", "set", "org.gnome.desktop.interface", "document-font-name", "Cantarell 11")
    gcss = CFG / "gtk-3.0/gtk.css"
    if gcss.exists() and "shoji" in gcss.read_text():
        gcss.unlink()
    src = HOME / ".local/share/themes" / GNOME_GTK / "gtk-4.0"
    for fname in ("assets", "gtk.css", "gtk-dark.css"):
        link = CFG / "gtk-4.0" / fname
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(src / fname)
    for ver in ("gtk-3.0", "gtk-4.0"):
        write(CFG / ver / "settings.ini", "[Settings]\ngtk-application-prefer-dark-theme=1\n"
              f"gtk-icon-theme-name=Papirus-Dark\ngtk-cursor-theme-name={CURSOR}\ngtk-cursor-theme-size=24\n")


# ---------- renders (cairo) ----------
def cairo_rgb(h, a=1.0):
    r, g, b = rgb(h)
    return (r / 255, g / 255, b / 255, a)


def enso(ctx, cx, cy, r, frac, color, width, gap=0.06, inner=True):
    """Open brush circle: main stroke + a thin offset echo, drawn clockwise from the top."""
    import cairo
    start = -math.pi / 2 - math.radians(6)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    if frac > 0:
        ctx.set_source_rgba(*color)
        ctx.set_line_width(width)
        ctx.arc(cx, cy, r, start, start + 2 * math.pi * (1 - gap) * frac)
        ctx.stroke()
        if inner and frac > 0.08:
            ctx.set_source_rgba(color[0], color[1], color[2], color[3] * 0.5)
            ctx.set_line_width(max(1, width * 0.25))
            ctx.arc(cx, cy, r - width * 0.75, start + 0.06, start + 2 * math.pi * (1 - gap) * frac * 0.8)
            ctx.stroke()


def render_enso_levels(t):
    """Bar rings 0..100 step 5: accent (level), muted (muted), alert (low battery), ok (charging)."""
    import cairo
    out = CACHE / "enso"
    out.mkdir(parents=True, exist_ok=True)
    size = 36
    for kind, col in (("accent", t["accent"]), ("muted", t["muted"]), ("alert", t["alert"]),
                      ("ok", t["ok"]), ("text", t["text"])):
        for n in range(0, 101, 5):
            s = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
            c = cairo.Context(s)
            c.set_source_rgba(*cairo_rgb(t["text"], 0.16))
            c.set_line_width(4.2)
            c.set_line_cap(cairo.LINE_CAP_ROUND)
            st = -math.pi / 2 - math.radians(6)
            c.arc(size / 2, size / 2, 13, st, st + 2 * math.pi * 0.94)
            c.stroke()
            enso(c, size / 2, size / 2, 13, n / 100, cairo_rgb(col), 4.2, inner=False)
            s.write_to_png(str(out / f"{kind}-{n}.png"))


def render_lock_enso(t):
    """One brush stroke: pressed in at the start, a steady body, then a dry tail that splits into
    bristle streaks. The wobble is seeded, so every render (and every palette) draws the same hand."""
    import cairo
    import random
    size = 640
    s = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    c = cairo.Context(s)
    cx = cy = size / 2
    col = cairo_rgb(t["text"], 1)
    rnd = random.Random(7)
    a0, a1, n = 2.25, 2.25 + 5.3, 360     # starts lower left, sweeps clockwise; the gap stays open
    body = 32

    def radius(a):
        return 258 * (1 + 0.007 * math.sin(2 * a + 0.7) + 0.004 * math.sin(5 * a + 2.1))

    def width(u):  # u: 0 at the start of the stroke, 1 at the tail
        if u < 0.06:
            return body * (0.7 + 0.3 * math.sin(u / 0.06 * math.pi / 2))
        if u < 0.62:
            return body * (1 - 0.25 * (u - 0.06) / 0.56)
        return body * 0.75 * (1 - (min(u, 1) - 0.62) / 0.38) ** 1.15

    def point(u, offset):
        a = a0 + (a1 - a0) * u
        r = radius(a) + offset
        return cx + r * math.cos(a), cy + r * math.sin(a)

    us = [i / n for i in range(n + 1)]
    c.push_group()  # body + rounded start inked once, then laid down at 0.9
    c.set_source_rgba(col[0], col[1], col[2], 1)
    c.move_to(*point(0, width(0) / 2))
    for u in us[1:]:
        c.line_to(*point(u, width(u) / 2))
    for u in reversed(us):
        c.line_to(*point(u, -width(u) / 2))
    c.close_path()
    c.fill()
    x, y = point(0, 0)  # rounded, loaded start
    c.arc(x, y, width(0) / 2, 0, 2 * math.pi)
    c.fill()
    c.pop_group_to_source()
    c.paint_with_alpha(0.9)
    # dry brush: thin gaps open up inside the body as the ink runs out ...
    c.set_operator(cairo.OPERATOR_CLEAR)
    for _ in range(7):
        across, u_start = rnd.uniform(-0.36, 0.36), rnd.uniform(0.55, 0.8)
        c.set_line_width(rnd.uniform(1.0, 2.2))
        c.move_to(*point(u_start, across * width(u_start)))
        for u in us:
            if u > u_start:
                c.line_to(*point(u, across * width(u)))
        c.stroke()
    # ... and a few bristles run on past the end of the body
    c.set_operator(cairo.OPERATOR_OVER)
    c.set_line_cap(cairo.LINE_CAP_ROUND)
    for _ in range(5):
        across, u_end = rnd.uniform(-0.5, 0.5), rnd.uniform(1.0, 1.04)
        c.set_source_rgba(col[0], col[1], col[2], rnd.uniform(0.45, 0.8))
        c.set_line_width(rnd.uniform(0.8, 1.6))
        u = 0.9
        c.move_to(*point(u, across * width(u)))
        while u < u_end:
            u += 0.004
            c.line_to(*point(u, across * max(width(u), 6)))
        c.stroke()
    CACHE.mkdir(parents=True, exist_ok=True)
    s.write_to_png(str(CACHE / "lock-enso.png"))
    # the seal (錠) is drawn by hyprlock as a label on an accent shape


def monitor_size():
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)
        m = max(mons, key=lambda m: m["width"] * m["height"])
        return m["width"], m["height"]
    except Exception:
        return 2560, 1440


def render_wallpaper(name):
    import cairo
    p = PALETTES[name]
    w, h = monitor_size()
    s = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
    c = cairo.Context(s)
    g = cairo.LinearGradient(0, 0, 0, h)
    g.add_color_stop_rgba(0, *cairo_rgb(p["sky"][0]))
    g.add_color_stop_rgba(1, *cairo_rgb(p["sky"][1]))
    c.set_source(g)
    c.paint()
    # the sun on light palettes; on dark ones tonight's moon, in its real phase
    cx, cy, r = w * 0.727, h * 0.333, w * 0.0656
    if p["dark"]:
        draw_moon(c, cx, cy, r, moon_phase(), cairo_rgb(p["accent"], 0.92), cairo_rgb(p["accent"], 0.10))
    else:
        halo = cairo.RadialGradient(cx, cy, r * 0.9, cx, cy, r * 1.5)
        halo.add_color_stop_rgba(0, *cairo_rgb(p["accent"], 0.18))
        halo.add_color_stop_rgba(1, *cairo_rgb(p["accent"], 0))
        c.set_source(halo)
        c.arc(cx, cy, r * 1.5, 0, 2 * math.pi)
        c.fill()
        c.set_source_rgba(*cairo_rgb(p["accent"], 0.9))
        c.arc(cx, cy, r, 0, 2 * math.pi)
        c.fill()
    sx, sy = w / 1280, h / 720
    ridges = [
        [(0, 470), (120, 400), (210, 440), (330, 350), (450, 430), (560, 380), (700, 450), (820, 390), (960, 455), (1100, 400), (1280, 450)],
        [(0, 560), (160, 500), (300, 545), (420, 490), (600, 560), (760, 515), (900, 565), (1060, 520), (1280, 570)],
        [(0, 640), (220, 600), (380, 630), (560, 595), (760, 640), (980, 605), (1280, 645)],
    ]
    import random
    rnd = random.Random(3)  # the same hand every time
    for i, (ridge, col) in enumerate(zip(ridges, p["hills"])):
        # ink wash: smooth ridges with a little tremor, the ink pooled darker along the crest
        pts = [(x * sx + rnd.uniform(-4, 4) * sx, y * sy + rnd.uniform(-5, 5) * sy) for x, y in ridge]
        pts[0], pts[-1] = (0, pts[0][1]), (w, pts[-1][1])
        c.move_to(0, h)
        c.line_to(*pts[0])
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            # slopes sag like a brush stroke and the peaks stay sharp
            low, sag = max(y0, y1), 0.3
            ya, yb = y0 + (y1 - y0) / 3, y0 + (y1 - y0) * 2 / 3
            c.curve_to(x0 + (x1 - x0) / 3, ya + (low - ya) * sag, x0 + (x1 - x0) * 2 / 3, yb + (low - yb) * sag, x1, y1)
        c.line_to(w, h)
        c.close_path()
        top = min(y for _, y in pts)
        ink = cairo.LinearGradient(0, top, 0, top + 160 * sy)
        ink.add_color_stop_rgba(0, *cairo_rgb(mix(col, "#000000", 0.18 if p["dark"] else 0.10)))
        ink.add_color_stop_rgba(1, *cairo_rgb(col))
        c.set_source(ink)
        c.fill()
        if i == 0:  # mist between the first and second ridge
            m = cairo.LinearGradient(0, 420 * sy, 0, 540 * sy)
            m.add_color_stop_rgba(0, *cairo_rgb(p["sky"][1], 0))
            m.add_color_stop_rgba(0.55, *cairo_rgb(p["sky"][1], 0.7))
            m.add_color_stop_rgba(1, *cairo_rgb(p["sky"][1], 0))
            c.set_source(m)
            c.rectangle(0, 420 * sy, w, 120 * sy)
            c.fill()
    WALLS.mkdir(parents=True, exist_ok=True)
    out = WALLS / f"shoji-{name}.png"
    s.write_to_png(str(out))
    return out


def moon_phase(when=None):
    """0 = new moon, 0.5 = full, from a mean synodic month after the new moon of 2000-01-06."""
    ref = datetime.datetime(2000, 1, 6, 18, 14, tzinfo=datetime.timezone.utc)
    now = when or datetime.datetime.now(datetime.timezone.utc)
    return ((now - ref).total_seconds() / 86400 / 29.530588853) % 1


def draw_moon(c, cx, cy, r, phase, lit, dark):
    """The dark disc faintly (earthshine), then the lit part: the limb on the sunny side and the
    terminator, an ellipse whose width follows the phase."""
    c.set_source_rgba(*dark)
    c.arc(cx, cy, r, 0, 2 * math.pi)
    c.fill()
    k = math.cos(2 * math.pi * phase)          # 1 new, 0 quarter, -1 full
    side = 1 if phase < 0.5 else -1            # waxing: lit on the right
    c.new_path()
    c.arc(cx, cy, r, -math.pi / 2, math.pi / 2) if side > 0 else c.arc(cx, cy, r, math.pi / 2, 3 * math.pi / 2)
    steps = 64
    for i in range(steps + 1):                  # the terminator, back to where the limb began
        a = math.pi * i / steps
        c.line_to(cx + side * k * r * math.sin(a), cy + side * r * math.cos(a))
    c.close_path()
    c.set_source_rgba(*lit)
    c.fill()


def set_wallpaper(path=None):
    """Show a wallpaper with whatever is installed: awww, then hyprpaper, then swaybg.

    No path: the last one shoji set (Hyprland autostart)."""
    import shutil
    last = STATE.parent / "shoji-wallpaper"
    if path is None:
        try:
            path = Path(last.read_text().strip())
        except OSError:
            path = WALLS / f"shoji-{current()}.png"
    path = Path(path).expanduser()
    if not path.exists():
        return
    write(last, str(path) + "\n")
    import shutil as _sh
    CACHE.mkdir(parents=True, exist_ok=True)
    _sh.copyfile(path, CACHE / "lock.png")  # hyprlock background
    hypr_wall = HOME / ".local/bin/hypr-wall"
    awww = shutil.which("awww") or (HOME / ".cargo/bin/awww").exists() and str(HOME / ".cargo/bin/awww")
    if hypr_wall.exists() and awww:
        run(str(hypr_wall), "set", str(path))
    elif awww:
        daemon = awww + "-daemon"
        if subprocess.run(["pgrep", "-x", "awww-daemon"], stdout=subprocess.DEVNULL).returncode:
            subprocess.Popen([daemon], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            import time
            time.sleep(0.5)
        run(awww, "img", str(path), "--transition-type", "grow")
    elif shutil.which("hyprpaper"):
        ver = subprocess.run(["hyprpaper", "--version"], capture_output=True, text=True).stdout
        nums = [int(x) for x in __import__("re").findall(r"(\d+)\.(\d+)", ver)[0]] if "." in ver else [0, 8]
        if nums >= [0, 8]:  # 0.8 switched to block syntax
            conf = f"wallpaper {{\n    monitor =\n    path = {path}\n    fit_mode = cover\n}}\n"
        else:
            conf = f"preload = {path}\nwallpaper = , {path}\n"
        write(CFG / "hypr/hyprpaper.conf", f"# Generated by shoji\n{conf}splash = false\n")
        run("pkill", "-x", "hyprpaper")
        subprocess.Popen(["hyprpaper"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif shutil.which("swaybg"):
        run("pkill", "-x", "swaybg")
        subprocess.Popen(["swaybg", "-m", "fill", "-i", str(path)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


# ---------- commands ----------
def reload_apps():
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        run("hyprctl", "reload")
    run("pkill", "-SIGUSR2", "-x", "waybar")
    if subprocess.run(["pgrep", "-x", "swaync"], stdout=subprocess.DEVNULL).returncode == 0:
        run("swaync-client", "-rs", "-sw")
    run("pkill", "-SIGUSR2", "-x", "ghostty")
    run("pkill", "-RTMIN+10", "-x", "waybar")  # ensō volume image
    restart_thunar()


def thunar_folder(name):
    """A Thunar window title names only the folder: find the one it most likely is."""
    if name.startswith("/"):
        return Path(name)  # misc-window-title-style = full path
    if name == HOME.name:
        return HOME
    found = []
    for root, dirs, _ in os.walk(HOME):
        depth = len(Path(root).relative_to(HOME).parts)
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"] if depth < 3 else []
        found += [Path(root) / d for d in dirs if d == name]
        if len(found) > 1:
            break
    return found[0] if len(found) == 1 else HOME


def restart_thunar():
    """GTK3 reads gtk.css once, so a running Thunar is restarted to pick up the palette. Its windows
    come back on the same folders and workspaces. Never while a dialog (copy progress, rename …) is open."""
    if subprocess.run(["pgrep", "-x", "thunar"], stdout=subprocess.DEVNULL).returncode != 0:
        return
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3).stdout
        wins = [c for c in json.loads(out or "[]") if c.get("class", "").lower() == "thunar"]
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return
    if any(not c.get("title", "").endswith(" - Thunar") for c in wins):
        return
    run("thunar", "-q")
    for _ in range(30):
        if subprocess.run(["pgrep", "-x", "thunar"], stdout=subprocess.DEVNULL).returncode != 0:
            break
        time.sleep(0.1)
    else:
        return
    quiet = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    subprocess.Popen(["thunar", "--daemon"], **quiet)
    rules = []
    for i, c in enumerate(wins):
        ws = c["workspace"]["name"] if c["workspace"]["id"] < 0 else str(c["workspace"]["id"])
        title = re.escape(c["title"]).replace("\\", "\\\\")
        name = f"shoji-thunar-{i}"
        run("hyprctl", "eval", f'hl.window_rule({{ name = "{name}", match = {{ class = "^[Tt]hunar$", '
                               f'title = "^{title}$" }}, workspace = "{ws} silent", no_initial_focus = true }})')
        rules.append(name)
        subprocess.Popen(["thunar", str(thunar_folder(c["title"][:-len(" - Thunar")]))], **quiet)
    if rules:  # the rules only place these windows; afterwards they must not catch new ones
        undo = "; ".join(f"hyprctl eval 'hl.window_rule({{ name = \"{n}\", match = {{ class = \"^shoji-never$\" }} }})'"
                         for n in rules)
        subprocess.Popen(["sh", "-c", f"sleep 3; {undo}"], **quiet)


def current():
    for f in (STATE,):
        try:
            name = f.read_text().strip()
            if name in PALETTES:
                return name
        except OSError:
            pass
    return DEFAULT


def kanji_num(n):
    if n <= 10:
        return KNUM[n]
    tens, ones = divmod(n, 10)
    return (KNUM[tens] if tens > 1 else "") + "十" + (KNUM[ones] if ones else "")


def cmd_doctor(name):
    t = tokens(name)
    print(f"{PALETTES[name]['name']} on {t['base']}")
    for k in ("text", "muted", "accent", "ok", "alert", "warn", "info"):
        cr = contrast(t[k], t["base"])
        print(f"  {k:<7} {t[k]}  {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    low = [f"{i}" for i, c in enumerate(ansi_colors(name)) if i and contrast(c, t["base"]) < 4.5]
    print(f"  terminal 16 colors  {'pass' if not low else 'FAIL ' + ','.join(low)}")
    on_diff = [c for i, c in enumerate(ansi_colors(name)) if i and not (PALETTES[name]["dark"] and i == 8)]
    cr = min(contrast(c, mix(t["base"], t[k], diff_tint(PALETTES[name]["dark"]))) for k in ("ok", "alert") for c in on_diff)
    print(f"  diff lines (delta)  {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    cr = contrast(t["on_accent"], t["accent"])
    print(f"  on_accent on accent {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    fonts = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout
    for f in ("Kaisei Opti", "Zen Kaku Gothic New", "lucide", "JetBrainsMono Nerd Font"):
        print(f"  font    {f:<24} {'ok' if f in fonts else 'MISSING'}")


def main():
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "status":
        print(current())
    elif cmd == "list":
        cur = current()
        for k, p in PALETTES.items():
            print(f"{'●' if k == cur else ' '} {k:<9} {p['kanji']:<3} {p['note']} ({'dark' if p['dark'] else 'light'})")
    elif cmd == "doctor":
        cmd_doctor(args[1] if len(args) > 1 else current())
    elif cmd == "gnome":
        gnome_reset()
    elif cmd == "vscode":
        write_vscode(current(), tokens(current()))
        install_vscode()
    elif cmd == "spotify":
        if not shutil_which("spicetify"):
            sys.exit("spicetify not found (https://spicetify.app)")
        write_spotify(current())
        run("spicetify", "config", "current_theme", "Shoji", "color_scheme", current())
        print("Shoji is the spicetify theme now: run `spicetify apply` (it restarts Spotify).\n"
              "Every `shoji apply` then sets the matching colour scheme for the next spicetify apply.")
    elif cmd == "chrome":
        write_chrome(current(), tokens(current()))
        print(f"Chrome: chrome://extensions → Developer mode → Load unpacked → {APPS / 'chrome'}\n"
              "After a palette change, press that extension's reload button.")
    elif cmd == "wallpaper":
        set_wallpaper(args[1] if len(args) > 1 else None)
    elif cmd == "date-kanji":
        d = datetime.date.today()
        print(f"{kanji_num(d.month)}月{kanji_num(d.day)}日 · {WEEK_K[d.weekday()]}曜日")
    elif cmd == "moon":  # tonight's phase on the wallpaper (dark palettes; hypr-widgets runs it daily)
        try:
            shown = (STATE.parent / "shoji-wallpaper").read_text().strip()
        except OSError:
            shown = ""
        ours = str(WALLS / f"shoji-{current()}.png")
        if PALETTES[current()]["dark"] and shown in ("", ours):  # never over a wallpaper you picked
            set_wallpaper(render_wallpaper(current()))
    elif cmd == "season":
        sid, kanji, colour = season()
        print(f"{sid} {kanji} {colour}")
    elif cmd == "weekday-kanji":
        print(WEEK_K[datetime.date.today().weekday()])
    elif cmd in ("apply", "toggle"):
        quiet = cmd == "apply" and len(args) == 1
        name = current() if quiet else (PALETTES[current()]["pair"] if cmd == "toggle" else args[1])
        if name not in PALETTES:
            sys.exit(f"unknown palette: {name} (shoji list)")
        wall = generate(name)
        reload_apps()
        if not quiet:
            set_wallpaper(wall)
            run("notify-send", "-a", "Shoji", f"{PALETTES[name]['kanji']} {PALETTES[name]['name']}", PALETTES[name]["note"])
            print(name)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
