#!/usr/bin/env bash
# Volume / mic keys with an on-screen popup (drawn by hypr-widgets, swaync as fallback).
# Usage: hypr-osd up|down|mute|micmute
case "$1" in
  up)      wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  down)    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute)    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  micmute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *) echo "usage: hypr-osd up|down|mute|micmute" >&2; exit 1 ;;
esac

if [ "$1" = micmute ]; then
  dev=@DEFAULT_AUDIO_SOURCE@; name=Microphone; on="󰍬"; off="󰍭"
else
  dev=@DEFAULT_AUDIO_SINK@; name=Volume; on="󰕾"; off="󰝟"
fi
read -r _ vol muted < <(wpctl get-volume "$dev")
pct=$(awk -v v="$vol" 'BEGIN { printf "%d", v * 100 + 0.5 }')
if [ -n "$muted" ]; then icon=$off; title="$name muted"; m=1; else icon=$on; title=$name; m=0; fi

# hypr-widgets draws the popup (shown even with Do Not Disturb on); swaync is the fallback
fifo=${XDG_RUNTIME_DIR:-/tmp}/hypr-osd.fifo
pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/hypr-widgets.pid" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ -p "$fifo" ]; then
  printf '%s\t%s\t%s\t%s\n' "$icon" "$title" "$pct" "$m" > "$fifo"
else
  notify-send -a OSD -u low -t 1500 \
    -h string:x-canonical-private-synchronous:osd -h "int:value:$pct" "$icon  $title" "$pct%"
fi
