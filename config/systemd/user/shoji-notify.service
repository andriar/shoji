[Unit]
Description=Shoji notifications (swaync)
Documentation=https://github.com/andriar/shoji
PartOf=shoji-session.service
BindsTo=shoji-session.service
After=shoji-session.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=swaync
ExecReload=swaync-client --reload-config ; swaync-client --reload-css
Restart=always
RestartSec=1
