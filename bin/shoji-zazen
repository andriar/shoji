#!/usr/bin/env python3
"""坐禅 Zazen: a focus session. Silences notifications, hides the bar, dims the windows you are not
in, and hypr-widgets shows a small ensō at the top that closes as the time passes. At the end
everything comes back and one notification says the session is done.

  shoji-zazen toggle [MIN]   start (default 25 min), or stop a running session
  shoji-zazen start [MIN] | stop | status
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE = RUN / "shoji-zazen.json"
FIFO = RUN / "hypr-osd.fifo"   # hypr-widgets draws the ensō
DEFAULT_MIN = 25


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def hypr_option(name):
    try:
        v = json.loads(run("hyprctl", "getoption", name, "-j") or "{}")
    except ValueError:
        return None
    return v.get("bool", v.get("int", v.get("float")))


def tell_widgets(line):
    if FIFO.is_fifo():
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, (line + "\n").encode())
        finally:
            os.close(fd)


def running():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return None


def start(minutes):
    if running():
        return
    state = {
        "start": time.time(), "minutes": minutes,
        "dnd": run("swaync-client", "-D") == "true",
        "dim": hypr_option("decoration:dim_inactive"),
        "dim_strength": hypr_option("decoration:dim_strength"),
        "bar": subprocess.run(["pgrep", "-x", "waybar"], capture_output=True).returncode == 0,
    }
    STATE.write_text(json.dumps(state))
    run("swaync-client", "-dn")
    run("hyprctl", "eval", "hl.config({ decoration = { dim_inactive = true, dim_strength = 0.35 } })")
    if state["bar"]:
        run("pkill", "-SIGUSR1", "-x", "waybar")  # SIGUSR1 toggles the bar's visibility
    tell_widgets("zazen\tstart")


def stop(done=False):
    state = running()
    if not state:
        return
    STATE.unlink(missing_ok=True)
    tell_widgets("zazen\tstop")
    if not state.get("dnd"):
        run("swaync-client", "-df")
    dim = "true" if state.get("dim") else "false"
    strength = state.get("dim_strength") or 0.5
    run("hyprctl", "eval", f"hl.config({{ decoration = {{ dim_inactive = {dim}, dim_strength = {strength} }} }})")
    if state.get("bar"):
        run("pkill", "-SIGUSR1", "-x", "waybar")
    minutes = round((time.time() - state["start"]) / 60)
    if done:
        run("notify-send", "-a", "Zazen", "坐禅 · done", f"{state['minutes']} minutes of focus. Breathe, stretch, drink water.")
    elif minutes:
        run("notify-send", "-a", "Zazen", "-u", "low", "坐禅 · stopped", f"after {minutes} of {state['minutes']} minutes")


def main():
    args = sys.argv[1:] or ["toggle"]
    cmd = args[0]
    minutes = int(args[1]) if len(args) > 1 and args[1].isdigit() else DEFAULT_MIN
    if cmd == "toggle":
        stop() if running() else start(minutes)
    elif cmd == "start":
        start(minutes)
    elif cmd == "stop":
        stop(done="--done" in args)
    elif cmd == "status":
        state = running()
        if state:
            left = state["minutes"] * 60 - (time.time() - state["start"])
            print(f"zazen {max(0, round(left / 60))} min left of {state['minutes']}")
        else:
            print("off")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
