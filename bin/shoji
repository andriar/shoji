FOLDER_ICONS = {
    "folder": None, "folder-open": None, "inode-directory": None,
    "folder-documents": "file-text", "folder-download": "download", "folder-music": "music",
    "folder-pictures": "image", "folder-videos": "clapperboard", "user-desktop": "monitor",
