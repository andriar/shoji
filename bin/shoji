#!/usr/bin/env python3
"""Shoji (障子) — one palette file for the whole Hyprland desktop.

Usage: shoji [apply [NAME]|list|status|toggle|doctor|gnome|vscode|spotify|chrome|moon|season|date-kanji|weekday-kanji]
  apply NAME    switch to a palette (no NAME: re-apply the saved one, quiet; Hyprland autostart)
  list          palettes, the current one marked
  toggle        dark <-> light (Hiru, or Yuki for Aizome)
  doctor        contrast of text / muted / accent against the ground
  gnome         put GTK back to the GNOME session's look (GNOME autostart)
  wallpaper [P] show P (default: the last one) with awww, hyprpaper or swaybg
  vscode        install the Shoji VS Code theme (once; every apply updates it)
  spotify       make Shoji the spicetify theme (then run `spicetify apply` when Spotify can restart)
  chrome        where the Chrome theme is and how to load it
  moon          redraw the wallpaper with tonight's moon phase (dark palettes)
  season        the season for the seasonal accent: spring 紅梅 / summer 青竹 / autumn 紅葉 / winter 白群
  date-kanji    十月二十四日 · 土曜日   (lock screen)
  weekday-kanji 土                    (bar)

Every app config imports a generated file; nothing else hard-codes a hex value.
Also renders, per palette: the ink-mountain wallpaper (the sun on light palettes, the moon in
tonight's phase on dark ones), the lock-screen ensō and
the bar's ensō level rings (~/.cache/shoji).
"""
import datetime
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CFG = HOME / ".config"
CACHE = HOME / ".cache/shoji"
STATE = HOME / ".local/state/shoji"
WALLS = HOME / "Pictures/Wallpapers"
DEFAULT = "aizome"
GNOME_GTK = "catppuccin-mocha-peach-standard+default"
CURSOR = "Bibata-Modern-Classic"
ICON_THEME = HOME / ".local/share/icons/Shoji"

DARK_ANSI = ["#e0707a", "#a3b46f", "#d9b05a", "#7f9dcb", "#b49ac9", "#7fb8b5",
             "#ec8f97", "#b8c789", "#e6c47c", "#9cb4da", "#c7b1d9", "#9ccbc8"]

LIGHT_ANSI = ["#a3303c", "#56682a", "#735716", "#2e5185", "#7a4a8c", "#2f6f6a",
              "#c0424e", "#6b7f36", "#9c7a26", "#3d64a0", "#8f5aa3", "#3c8580"]


def diff_tint(dark):
    """delta +/- line background: this much ok/alert over the ground (the most that keeps 4.5:1)."""
    return 0.10 if dark else 0.07


PALETTES = {
    "aizome": dict(kanji="藍染", name="Aizome", note="indigo · gold", dark=True, pair="yuki",
                   bg="#111827", text="#e6e9f0", muted="#97a0b5", accent="#d9b05a", on_accent="#17161b",
                   sky=("#10172a", "#1b2540"), hills=("#172036", "#121a2d", "#0c1220")),
    "yoru": dict(kanji="夜", name="Yoru", note="ink · vermilion", dark=True, pair="hiru",
                 bg="#17161b", text="#ece6d8", muted="#a39d8f", accent="#e8603f", on_accent="#17161b",
                 sky=("#1c1b24", "#2a2733"), hills=("#24222c", "#1d1c23", "#141318")),
    "yozakura": dict(kanji="夜桜", name="Yozakura", note="night · sakura", dark=True, pair="hiru",
                     bg="#1b1720", text="#efe4ea", muted="#a898a6", accent="#ec93ad", on_accent="#17161b",
                     sky=("#1d1822", "#2c2433"), hills=("#262029", "#1f1a22", "#151217")),
    "koke": dict(kanji="苔", name="Koke", note="moss garden", dark=True, pair="hiru",
                 bg="#131814", text="#e3e8dc", muted="#97a293", accent="#a9c47c", on_accent="#17161b",
                 sky=("#141a16", "#202a22"), hills=("#1b231d", "#161d18", "#0f1411")),
    "hiru": dict(kanji="昼", name="Hiru", note="washi · vermilion", dark=False, pair="yoru",
                 bg="#f3eee3", text="#1f1d19", muted="#6a655b", accent="#b0402a", on_accent="#fbf8f1",
                 sky=("#f6f1e6", "#e6dece"), hills=("#d9d0bf", "#c9bfac", "#b3a893")),
    "yuki": dict(kanji="雪", name="Yuki", note="snow · indigo", dark=False, pair="aizome",
                 bg="#f2f4f6", text="#1b2230", muted="#5d6675", accent="#2e5185", on_accent="#fbf8f1",
                 sky=("#f4f6f8", "#dfe5ec"), hills=("#cfd7e1", "#bcc6d3", "#a5b1c1")),
}
WEEK_K = "月火水木金土日"  # datetime.weekday(): Monday = 0
KNUM = ["", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十"]


# ---------- color helpers ----------
def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexc(c):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in c)


def mix(a, b, t):
    return hexc(tuple(x + (y - x) * t for x, y in zip(rgb(a), rgb(b))))


def rgba(h, a):
    r, g, b = rgb(h)
    return f"rgba({r}, {g}, {b}, {a})"


def lum(h):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (ch(v) for v in rgb(h))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


# 季節 seasonal accent (prefs "seasonal": true): the accent becomes the season's traditional colour,
# shifted in lightness until it holds 3:1 on the palette's ground. Changes at 立春, 立夏, 立秋, 立冬.
SEASONS = [((2, 4), "spring", "紅梅", "#e16b8c"), ((5, 5), "summer", "青竹", "#00896c"),
           ((8, 7), "autumn", "紅葉", "#c9573c"), ((11, 7), "winter", "白群", "#78c2c4")]
PREFS = CFG / "shoji/prefs.json"


def season(day=None):
    """(id, kanji, colour) of the season `day` falls in."""
    d = day or datetime.date.today()
    current = SEASONS[-1]  # January to 3 February: still winter
    for start, *rest in SEASONS:
        if (d.month, d.day) >= start:
            current = (start, *rest)
    return current[1:]


def seasonal_on():
    try:
        return bool(json.loads(PREFS.read_text()).get("seasonal"))
    except (OSError, ValueError):
        return False


def fit_accent(colour, bg, text, dark):
    """Keep the hue, move the lightness (up on dark grounds, down on light) until the accent holds
    3:1 on the ground and its label (the ground or the text colour, whichever contrasts more) 4.5:1."""
    import colorsys
    r, g, b = (c / 255 for c in rgb(colour))
    h, l, sat = colorsys.rgb_to_hls(r, g, b)
    step = 0.02 if dark else -0.02
    best = colour
    for _ in range(40):
        best = hexc(tuple(round(c * 255) for c in colorsys.hls_to_rgb(h, l, sat)))
        on = bg if contrast(bg, best) >= contrast(text, best) else text
        if contrast(best, bg) >= 3.2 and contrast(on, best) >= 4.5:  # a mark on the ground, a label on it
            break
        l = min(0.92, max(0.08, l + step))
    return best, on


def tokens(name):
    """Palette -> every token the configs use (Catppuccin-style names kept for old CSS)."""
    p = PALETTES[name]
    dark = p["dark"]
    a = DARK_ANSI if dark else LIGHT_ANSI
    bg, text = p["bg"], p["text"]
    shade = "#000000"
    t = dict(
        base=bg, mantle=mix(bg, shade, 0.18 if dark else 0.04), crust=mix(bg, shade, 0.32 if dark else 0.08),
        surface0=mix(bg, text, 0.10), surface1=mix(bg, text, 0.16), surface2=mix(bg, text, 0.26),
        overlay0=mix(bg, text, 0.45), subtext0=p["muted"], muted=p["muted"], text=text,
        red=a[0], green=a[1], yellow=a[2], blue=a[3], mauve=a[4], teal=a[5],
        pink=a[10], lavender=a[9], rosewater=text, peach=p["accent"],
        accent=p["accent"], accent2=p["accent"], on_accent=p["on_accent"], accent_text=p["accent"],
        ok=a[1], alert=a[0], warn=a[2], info=a[3],
    )
    if seasonal_on():
        acc, on = fit_accent(season()[2], bg, text, dark)
        t.update(accent=acc, accent2=acc, accent_text=acc, peach=acc, on_accent=on)
    return t


def ansi_colors(name):
    """Terminal 16 colors. Every one but color 0 (a background on dark grounds) is >= 4.5:1."""
    p, t = PALETTES[name], tokens(name)
    a = DARK_ANSI if p["dark"] else LIGHT_ANSI
    if p["dark"]:
        return ([mix(t["base"], t["text"], 0.08)] + a[:6] + [mix(t["base"], t["text"], 0.78), t["muted"]]
                + a[6:] + [t["text"]])
    # light ground: "black" is the ink, "white" a readable grey, and the bright row goes darker
    # (not lighter) so every color stays readable on paper
    return ([mix(t["text"], t["base"], 0.10)] + a[:6] + [mix(t["base"], t["text"], 0.70), t["muted"]]
            + [mix(c, "#000000", 0.22) for c in a[:6]] + [t["text"]])


# ---------- generators ----------
def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def sed(path, pattern, repl):
    if path.exists():
        path.write_text(re.sub(pattern, repl, path.read_text(), flags=re.M))


def run(*cmd):
    # a reload must never block a palette switch (swaync-client waits forever when swaync is down)
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=5)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass


def generate(name):
    p = PALETTES[name]
    t = tokens(name)
    header = f"Generated by shoji ({p['name']}) — edit ~/.local/bin/shoji, not this file"
    bare = {k: v.lstrip("#") for k, v in t.items()}

    # Hyprland (Lua) + hyprlang twin for hyprlock / fallback hyprland.conf
    write(CFG / "hypr/theme.lua", f"-- {header}\nreturn {{\n"
          + "".join(f'    {k:<11} = "rgb({v})",\n' for k, v in bare.items())
          + f'    edge        = "rgba({bare["text"]}24)",\n'
          + f'    edge_dim    = "rgba({bare["text"]}0f)",\n'
          + f'    edge_active = "rgba({bare["text"]}47)",\n'
          + f'    shadow      = "rgba(000000{"55" if p["dark"] else "28"})",\n' + "}\n")
    write(CFG / "hypr/theme.conf", f"# {header}\n"
          + "".join(f"${k} = rgb({v})\n" for k, v in bare.items())
          + f"$edge = rgba({bare['text']}24)\n$glass = rgba({bare['base']}9e)\n"
          + f"$font_ui = Zen Kaku Gothic New\n$font_display = Kaisei Opti\n")

    # GTK3 CSS consumers: waybar, wlogout, swaync, hypr-widgets
    css = f"/* {header} */\n" + "".join(f"@define-color {k} {v};\n" for k, v in t.items())
    css += "".join(f"@define-color {k} {v};\n" for k, v in {
        # paper glass: bar < panels < tooltips; edge = hairline; group = chip fill
        "elev1": rgba(t["base"], 0.62), "elev2": rgba(t["base"], 0.80), "elev3": rgba(t["base"], 0.92),
        "edge": rgba(t["text"], 0.14), "group": rgba(t["text"], 0.06), "hover": rgba(t["text"], 0.10),
        "track": rgba(t["text"], 0.12),
    }.items())
    write(CFG / "waybar/colors.css", css)
    write(CFG / "wlogout/colors.css", css + f"@define-color backdrop {rgba(t['crust'], 0.85)};\n")
    write(CFG / "swaync/colors.css", css)

    # fuzzel (included from fuzzel.ini)
    write(CFG / "fuzzel/colors.ini", f"# {header}\n[main]\nicon-theme=Shoji\n"
          f"[colors]\nbackground={bare['base']}e6\ntext={bare['text']}ff\nprompt={bare['muted']}ff\n"
          f"placeholder={bare['muted']}ff\ninput={bare['text']}ff\nmatch={bare['accent']}ff\n"
          f"selection={bare['surface1']}ff\nselection-text={bare['text']}ff\n"
          f"selection-match={bare['accent']}ff\ncounter={bare['muted']}ff\nborder={bare['surface2']}ff\n")

    # Ghostty: full 16-color palette
    ansi = ansi_colors(name)
    write(CFG / "ghostty/theme-local", f"# {header}\n"
          f"background = {t['base']}\nforeground = {t['text']}\n"
          f"cursor-color = {t['text']}\ncursor-text = {t['base']}\n"
          f"selection-background = {mix(t['base'], t['accent'], 0.28)}\nselection-foreground = {t['text']}\n"
          # paper is opaque: a translucent light ground lets the wallpaper pull text below 4.5:1
          f"background-opacity = {0.88 if p['dark'] else 1}\n"
          + "".join(f"palette = {i}={c}\n" for i, c in enumerate(ansi)))

    # starship: replace the generated palette block
    star = CFG / "starship.toml"
    if star.exists():
        block = ("[palettes.shoji]\n" + f'text = "{t["text"]}"\nmuted = "{t["muted"]}"\n'
                 f'accent = "{t["accent"]}"\nalert = "{t["alert"]}"\n')
        s = star.read_text()
        s = re.sub(r"\[palettes\.[a-z]+\]\n(?:[a-z]+ = \"#[0-9a-f]{6}\"\n)+", block, s)
        s = re.sub(r'^palette = ".*"$', 'palette = "shoji"', s, flags=re.M)
        star.write_text(s)

    # btop
    write(CFG / "btop/themes/shoji.theme", f"# {header}\n" + "".join(
        f'theme[{k}]="{v}"\n' for k, v in {
            "main_bg": t["base"], "main_fg": t["text"], "title": t["text"], "hi_fg": t["accent"],
            "selected_bg": t["surface1"], "selected_fg": t["text"], "inactive_fg": t["overlay0"],
            "graph_text": t["muted"], "meter_bg": t["surface1"], "proc_misc": t["muted"],
            "cpu_box": t["surface2"], "mem_box": t["surface2"], "net_box": t["surface2"], "proc_box": t["surface2"],
            "div_line": t["surface1"], "temp_start": t["ok"], "temp_mid": t["warn"], "temp_end": t["alert"],
            "cpu_start": t["muted"], "cpu_mid": t["accent"], "cpu_end": t["alert"],
            "free_start": t["ok"], "free_mid": t["ok"], "free_end": t["ok"],
            "cached_start": t["info"], "cached_mid": t["info"], "cached_end": t["info"],
            "available_start": t["muted"], "available_mid": t["muted"], "available_end": t["muted"],
            "used_start": t["accent"], "used_mid": t["accent"], "used_end": t["alert"],
            "download_start": t["info"], "download_mid": t["info"], "download_end": t["text"],
            "upload_start": t["accent"], "upload_mid": t["accent"], "upload_end": t["text"],
            "process_start": t["muted"], "process_mid": t["accent"], "process_end": t["alert"],
        }.items()))
    sed(CFG / "btop/btop.conf", r"^color_theme = .*$", f'color_theme = "{CFG}/btop/themes/shoji.theme"')

    # qt6ct (role order: WindowText Button Light Midlight Dark Mid Text BrightText ButtonText Base
    #        Window Shadow Highlight HighlightedText Link LinkVisited AlternateBase NoRole
    #        ToolTipBase ToolTipText PlaceholderText Accent)
    def qrow(fg, hl, hl_fg):
        c = [fg, t["surface1"], t["surface2"], t["surface0"], t["crust"], t["mantle"], fg, t["text"], fg,
             t["base"], t["mantle"], t["crust"], hl, hl_fg, t["info"], t["mauve"], t["mantle"], "#ffffff",
             t["base"], t["text"], t["overlay0"], t["accent"]]
        return ", ".join("#ff" + x.lstrip("#") for x in c)
    write(CFG / "qt6ct/colors/shoji.conf", "[ColorScheme]\n"
          f"active_colors={qrow(t['text'], t['accent'], t['on_accent'])}\n"
          f"inactive_colors={qrow(t['muted'], t['surface1'], t['text'])}\n"
          f"disabled_colors={qrow(t['overlay0'], t['mantle'], t['overlay0'])}\n")
    sed(CFG / "qt6ct/qt6ct.conf", r"^color_scheme_path=.*$", f"color_scheme_path={CFG}/qt6ct/colors/shoji.conf")
    sed(CFG / "qt6ct/qt6ct.conf", r"^icon_theme=.*$", "icon_theme=Shoji")

    render_folders(t, p["dark"])
    apply_gtk(name, t)

    # shell env (sourced from ~/.zshrc): fzf colors; bat and delta highlight with the 16 terminal colors
    write(CFG / "shoji/shell.sh", f"# {header}\nexport FZF_DEFAULT_OPTS=\""
          f"--color=bg+:{t['surface0']},bg:-1,spinner:{t['accent']},hl:{t['accent']}"
          f",fg:{t['text']},header:{t['muted']},info:{t['muted']},pointer:{t['accent']}"
          f",marker:{t['accent']},fg+:{t['text']},prompt:{t['accent']},hl+:{t['accent']}"
          f",selected-bg:{t['surface1']},border:{t['surface2']},label:{t['text']}\"\n"
          "export BAT_THEME=ansi\n")
    write(CFG / "shoji/fzf.sh", f"# {header}\n. {CFG / 'shoji/shell.sh'}\n")  # older ~/.zshrc lines

    # delta feature: [include] path = ~/.config/shoji/delta.gitconfig, then [delta] features = shoji
    write(CFG / "shoji/delta.gitconfig", f"# {header}\n[delta \"shoji\"]\n"
          f"\t{'dark' if p['dark'] else 'light'} = true\n\tsyntax-theme = ansi\n"
          # a stronger tint would drop syntax colors below 4.5:1, so changed words get an underline
          f"\tminus-style = syntax \"{mix(t['base'], t['alert'], diff_tint(p['dark']))}\"\n"
          f"\tminus-emph-style = syntax \"{mix(t['base'], t['alert'], diff_tint(p['dark']))}\" ul\n"
          f"\tplus-style = syntax \"{mix(t['base'], t['ok'], diff_tint(p['dark']))}\"\n"
          f"\tplus-emph-style = syntax \"{mix(t['base'], t['ok'], diff_tint(p['dark']))}\" ul\n"
          f"\tline-numbers-minus-style = \"{t['alert']}\"\n\tline-numbers-plus-style = \"{t['ok']}\"\n"
          f"\tline-numbers-zero-style = \"{t['muted']}\"\n"
          f"\tline-numbers-left-style = \"{t['surface2']}\"\n\tline-numbers-right-style = \"{t['surface2']}\"\n"
          f"\tfile-style = \"{t['text']}\" bold\n\tfile-decoration-style = \"{t['surface2']}\" ul\n"
          f"\thunk-header-style = file line-number syntax\n"
          f"\thunk-header-decoration-style = \"{t['surface2']}\" box\n"
          f"\tcommit-style = \"{t['accent']}\"\n\tcommit-decoration-style = \"{t['surface2']}\" box ul\n"
          f"\tblame-palette = \"{t['base']} {t['mantle']}\"\n")

    write_apps(name, t)

    # widgets + renders
    write(CFG / "shoji/current.json", json.dumps(dict(id=name, **{k: v for k, v in p.items() if k not in ("sky", "hills")},
                                                      tokens=t), indent=1, ensure_ascii=False) + "\n")
    render_enso_levels(t)
    render_lock_enso(t)
    wall = render_wallpaper(name)
    if not (CACHE / "lock.png").exists():
        import shutil as _sh
        _sh.copyfile(wall, CACHE / "lock.png")
    write(STATE, name + "\n")
    return wall

# ---------- app themes (VS Code, Spotify via spicetify, Chrome) ----------
VSCODE_DIRS = [HOME / ".vscode/extensions", HOME / ".var/app/com.visualstudio.code/data/vscode/extensions"]
APPS = HOME / ".local/share/shoji/apps"


def vscode_theme(name, t):
    p = PALETTES[name]
    a = ansi_colors(name)
    sel = mix(t["base"], t["accent"], 0.28 if p["dark"] else 0.22)
    colors = {
        "foreground": t["text"], "focusBorder": t["accent"], "widget.shadow": "#00000040",
        "editor.background": t["base"], "editor.foreground": t["text"],
        "editor.lineHighlightBackground": mix(t["base"], t["text"], 0.04),
        "editor.selectionBackground": sel, "editor.findMatchBackground": mix(t["base"], t["accent"], 0.4),
        "editorCursor.foreground": t["accent"], "editorLineNumber.foreground": t["overlay0"],
        "editorLineNumber.activeForeground": t["text"], "editorIndentGuide.background1": t["surface0"],
        "editorWhitespace.foreground": t["surface1"], "editorGutter.background": t["base"],
        "editorWidget.background": t["mantle"], "editorSuggestWidget.background": t["mantle"],
        "editorSuggestWidget.selectedBackground": t["surface0"], "editorHoverWidget.background": t["mantle"],
        "sideBar.background": t["mantle"], "sideBar.foreground": t["subtext0"], "sideBar.border": t["crust"],
        "sideBarSectionHeader.background": t["mantle"], "sideBarTitle.foreground": t["text"],
        "activityBar.background": t["crust"], "activityBar.foreground": t["text"],
        "activityBar.inactiveForeground": t["overlay0"], "activityBarBadge.background": t["accent"],
        "activityBarBadge.foreground": t["on_accent"], "activityBar.activeBorder": t["accent"],
        "titleBar.activeBackground": t["crust"], "titleBar.activeForeground": t["text"],
        "titleBar.inactiveBackground": t["crust"], "statusBar.background": t["crust"],
        "statusBar.foreground": t["subtext0"], "statusBar.noFolderBackground": t["crust"],
        "statusBarItem.remoteBackground": t["accent"], "statusBarItem.remoteForeground": t["on_accent"],
        "tab.activeBackground": t["base"], "tab.inactiveBackground": t["mantle"],
        "tab.activeForeground": t["text"], "tab.inactiveForeground": t["overlay0"],
        "tab.activeBorderTop": t["accent"], "tab.border": t["crust"], "editorGroupHeader.tabsBackground": t["mantle"],
        "panel.background": t["mantle"], "panel.border": t["crust"], "panelTitle.activeBorder": t["accent"],
        "list.activeSelectionBackground": t["surface0"], "list.activeSelectionForeground": t["text"],
        "list.inactiveSelectionBackground": t["surface0"], "list.hoverBackground": mix(t["mantle"], t["text"], 0.05),
        "list.highlightForeground": t["accent"], "input.background": t["surface0"], "input.border": t["surface1"],
        "dropdown.background": t["mantle"], "button.background": t["accent"], "button.foreground": t["on_accent"],
        "badge.background": t["accent"], "badge.foreground": t["on_accent"],
        "progressBar.background": t["accent"], "scrollbarSlider.background": t["surface0"] + "99",
        "scrollbarSlider.hoverBackground": t["surface1"], "textLink.foreground": t["info"],
        "gitDecoration.modifiedResourceForeground": t["warn"], "gitDecoration.untrackedResourceForeground": t["ok"],
        "gitDecoration.deletedResourceForeground": t["alert"], "errorForeground": t["alert"],
        "editorError.foreground": t["alert"], "editorWarning.foreground": t["warn"], "editorInfo.foreground": t["info"],
        "terminal.background": t["base"], "terminal.foreground": t["text"], "terminalCursor.foreground": t["accent"],
        **{f"terminal.ansi{n}": a[i] for i, n in enumerate(
            ["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White", "BrightBlack", "BrightRed",
             "BrightGreen", "BrightYellow", "BrightBlue", "BrightMagenta", "BrightCyan", "BrightWhite"])},
    }
    def tok(scope, color, style=None):
        rule = {"scope": scope, "settings": {"foreground": color}}
        if style:
            rule["settings"]["fontStyle"] = style
        return rule
    tokens_ = [
        tok(["comment", "punctuation.definition.comment"], t["overlay0"], "italic"),
        tok(["keyword", "storage", "storage.type", "keyword.control"], a[3]),     # gold / ochre
        tok(["string", "markup.inline.raw"], a[2]),
        tok(["constant.numeric", "constant.language", "constant.character"], a[5]),
        tok(["entity.name.function", "support.function", "meta.function-call"], a[4]),
        tok(["entity.name.type", "entity.name.class", "support.type", "support.class"], a[6]),
        tok(["entity.name.tag"], a[1]), tok(["entity.other.attribute-name"], a[3], "italic"),
        tok(["variable.parameter"], t["subtext0"], "italic"), tok(["variable", "meta.definition.variable"], t["text"]),
        tok(["keyword.operator", "punctuation"], t["subtext0"]),
        tok(["markup.heading", "markup.bold"], t["accent"], "bold"), tok(["markup.italic"], t["text"], "italic"),
        tok(["markup.inserted"], t["ok"]), tok(["markup.deleted"], t["alert"]), tok(["invalid"], t["alert"]),
    ]
    return {"name": "Shoji", "type": "dark" if p["dark"] else "light", "colors": colors,
            "tokenColors": tokens_, "semanticHighlighting": True}


def write_vscode(name, t):
    """A theme extension: `shoji vscode` installs it once (code --install-extension); after that
    every apply rewrites the installed theme file, and VS Code follows (Reload Window if not)."""
    p = PALETTES[name]
    theme = json.dumps(vscode_theme(name, t), indent=1)
    package = json.dumps({
        "name": "shoji-theme", "displayName": "Shoji", "publisher": "shoji", "version": "0.1.0",
        "description": "The current Shoji palette (generated by shoji apply)",
        "engines": {"vscode": "^1.60.0"}, "categories": ["Themes"],
        "contributes": {"themes": [{"label": "Shoji", "uiTheme": "vs-dark" if p["dark"] else "vs",
                                    "path": "./themes/shoji.json"}]}}, indent=1)
    src = APPS / "vscode"
    write(src / "package.json", package)
    write(src / "themes/shoji.json", theme)
    for d in VSCODE_DIRS:
        for inst in d.glob("shoji.shoji-theme-*"):
            write(inst / "themes/shoji.json", theme)
            write(inst / "package.json", package)


def install_vscode():
    import shutil
    import zipfile
    vsix = APPS / "shoji-theme.vsix"
    with zipfile.ZipFile(vsix, "w") as z:
        z.writestr("extension.vsixmanifest", """<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
 <Metadata><Identity Language="en-US" Id="shoji-theme" Version="0.1.0" Publisher="shoji"/>
  <DisplayName>Shoji</DisplayName><Description xml:space="preserve">Shoji palette</Description>
  <Categories>Themes</Categories></Metadata>
 <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation>
 <Dependencies/>
 <Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/></Assets>
</PackageManifest>
""")
        z.writestr("[Content_Types].xml", '<?xml version="1.0" encoding="utf-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension=".json" ContentType="application/json"/><Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>')
        z.write(APPS / "vscode/package.json", "extension/package.json")
        z.write(APPS / "vscode/themes/shoji.json", "extension/themes/shoji.json")
    done = False
    for cmd in (["code"], ["flatpak", "run", "com.visualstudio.code"]):
        if shutil.which(cmd[0]) and subprocess.run([*cmd, "--install-extension", str(vsix), "--force"]).returncode == 0:
            done = True
    print("VS Code: pick it with Ctrl+K Ctrl+T → Shoji" if done else f"VS Code not found; the extension is at {vsix}")


def spicetify_ini():
    """Every palette as a spicetify colour scheme; `shoji spotify` selects the current one."""
    out = [f"; Generated by shoji: one section per palette\n"]
    for pid in PALETTES:
        t = tokens(pid)
        rows = {"text": t["text"], "subtext": t["subtext0"], "main": t["base"], "main-elevated": t["surface0"],
                "highlight": t["surface0"], "highlight-elevated": t["surface1"], "sidebar": t["mantle"],
                "player": t["mantle"], "card": t["surface0"], "shadow": t["crust"], "selected-row": t["text"],
                "button": t["accent"], "button-active": t["accent"], "button-disabled": t["overlay0"],
                "tab-active": t["surface1"], "notification": t["surface1"], "notification-error": t["alert"],
                "misc": t["overlay0"]}
        out.append(f"[{pid}]\n" + "".join(f"{k:<20} = {v.lstrip('#')}\n" for k, v in rows.items()))
    return "\n".join(out)


def write_spotify(name):
    d = CFG / "spicetify/Themes/Shoji"
    if not (CFG / "spicetify").exists():
        return
    write(d / "color.ini", spicetify_ini())
    if not (d / "user.css").exists():
        write(d / "user.css", "/* Shoji: colours come from color.ini (one section per palette) */\n")
    ini = CFG / "spicetify/config-xpui.ini"
    if ini.exists() and re.search(r"^current_theme\s*=\s*Shoji\s*$", ini.read_text(), re.M):
        sed(ini, r"^color_scheme\s*=.*$", f"color_scheme           = {name}")  # takes effect on `spicetify apply`


def write_chrome(name, t):
    """An unpacked Chrome theme: load the folder once (chrome://extensions, Developer mode,
    Load unpacked); after a palette change press its reload button."""
    def c(h):
        return list(rgb(h))
    write(APPS / "chrome/manifest.json", json.dumps({
        "manifest_version": 3, "name": "Shoji", "version": "0.1.0",
        "description": f"Shoji palette ({PALETTES[name]['name']})",
        "theme": {"colors": {
            "frame": c(t["crust"]), "frame_inactive": c(t["crust"]), "toolbar": c(t["mantle"]),
            "tab_text": c(t["text"]), "tab_background_text": c(t["overlay0"]), "bookmark_text": c(t["subtext0"]),
            "ntp_background": c(t["base"]), "ntp_text": c(t["text"]), "ntp_link": c(t["accent"]),
            "omnibox_background": c(t["surface0"]), "omnibox_text": c(t["text"]),
            "toolbar_button_icon": c(t["subtext0"]), "button_background": c(t["surface0"])},
            "properties": {"ntp_logo_alternate": 1}}}, indent=1))


def shutil_which(prog):
    import shutil
    return shutil.which(prog) or (HOME / ".local/bin" / prog).exists()


def write_apps(name, t):
    write_vscode(name, t)
    write_spotify(name)
    write_chrome(name, t)



def cursor_installed():
    return any((Path(d) / "icons" / CURSOR).exists() for d in (HOME / ".local/share", HOME / ".icons", "/usr/share"))


