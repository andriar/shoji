#!/usr/bin/env python3
"""CPU + RAM as one waybar chip (JSON). Neutral until either passes 70% (warning) or 90% (critical)."""
import json
import os
from pathlib import Path

STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypr-sysload.prev"


def cpu_percent():
    fields = [int(x) for x in Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]]
    idle, total = fields[3] + fields[4], sum(fields)
    try:
        prev_idle, prev_total = map(int, STATE.read_text().split())
    except (OSError, ValueError):
        prev_idle, prev_total = 0, 0
    STATE.write_text(f"{idle} {total}")
    d_total = total - prev_total
    return 0 if d_total <= 0 else round(100 * (1 - (idle - prev_idle) / d_total))


def mem_percent():
    info = dict(line.split(":", 1) for line in Path("/proc/meminfo").read_text().splitlines())
    kb = lambda k: int(info[k].split()[0])
    return round(100 * (1 - kb("MemAvailable") / kb("MemTotal")))


cpu, mem = cpu_percent(), mem_percent()
peak = max(cpu, mem)
cls = "critical" if peak >= 90 else "warning" if peak >= 70 else "normal"
print(json.dumps({
    "text": f"cpu {cpu:>2} · mem {mem:>2}",  # fixed width: neighbours do not shift
    "class": cls,
    "tooltip": f"CPU {cpu}% · RAM {mem}%\nClick: open btop",
}, ensure_ascii=False))
