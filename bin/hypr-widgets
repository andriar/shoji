#!/usr/bin/env python3
"""Shoji shell widgets that waybar and swaync can't draw (one GTK3 layer-shell process).

  osd       ensō ring, top right: volume / mic level, shown even when Do Not Disturb is on.
            hypr-osd writes "icon<TAB>title<TAB>percent<TAB>muted" lines to $FIFO.
  calendar  Koyomi: kanji week, today as a seal; sits left of the swaync control center
            while it is open (follows swaync's SubscribeV2 cc_open signal).
  popovers  Sound (devices + volume), Network, Battery, the Theme manager, the launcher and the
            shortcuts sheet. hypr-pop writes "pop<TAB>audio|network|battery|theme|launcher|keys" to $FIFO;
            the same line again closes it.

Colors: ~/.config/waybar/colors.css for GTK CSS and ~/.config/shoji/current.json for cairo,
both written by `shoji apply`, re-read on every show.
"""
import calendar as cal_mod
import datetime
import importlib.machinery
import json
import math
import os
import subprocess
import sys
from pathlib import Path

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GLib, Gio, Gtk, GtkLayerShell as Layer, PangoCairo  # noqa: E402

HOME = Path.home()
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
FIFO = RUN / "hypr-osd.fifo"
PIDFILE = RUN / "hypr-widgets.pid"
COLORS = HOME / ".config/waybar/colors.css"
THEME = HOME / ".config/shoji/current.json"
PREFS = HOME / ".config/shoji/prefs.json"
SHOJI = str(HOME / ".local/bin/shoji")
LUCIDE = json.loads((HOME / ".local/share/fonts/Shoji/lucide-info.json").read_text())
CC_WIDTH = 420      # swaync control-center-width
GAP = 8
OSD_MS = 1400
OSD_TWEEN_MS = 240
WEEK_K = "日月火水木金土"  # Sunday first, like the calendar grid


def icon(name):
    return chr(int(LUCIDE[name]["encodedCode"].lstrip("\\"), 16))


def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def theme():
    try:
        return json.loads(THEME.read_text())
    except (OSError, ValueError):
        return {"tokens": {"base": "#111827", "text": "#e6e9f0", "muted": "#97a0b5", "accent": "#d9b05a",
                           "on_accent": "#17161b"}, "dark": True}


def prefs():
    try:
        return json.loads(PREFS.read_text())
    except (OSError, ValueError):
        return {}


def save_prefs(**kw):
    p = prefs()
    p.update(kw)
    PREFS.write_text(json.dumps(p, indent=1) + "\n")


def rgba(h, a=1.0):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)) + (a,)


