#!/usr/bin/env python3
"""Workspace buttons for waybar under Hyprland's Lua config.

waybar's hyprland/workspaces module switches workspaces with the old `dispatch workspace N`,
which Hyprland 0.55+ in Lua mode rejects, so its buttons cannot be clicked. Shoji draws them as
custom/ws#wN modules instead, and their on-click sends `hl.dsp.focus({ workspace = N })`.

  shoji-ws watch   run by waybar (custom/ws-watch): follows Hyprland's event socket, writes one
                   JSON line per workspace to $XDG_RUNTIME_DIR/shoji-ws/N and signals waybar
  shoji-ws N       what custom/ws#wN prints (the file above; empty = hidden)
"""
import json
import os
import signal
import socket
import subprocess
import sys
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
DIR = RUN / "shoji-ws"
PIDFILE = DIR / "watch.pid"
PREFS = Path.home() / ".config/shoji/prefs.json"
SIGNAL = 7            # "signal": 7 on every custom/ws#wN module
PERSISTENT = 4        # 一 二 三 四 always show, like persistent-workspaces
KANJI = "一二三四五六七八九十"
EVENTS = {"workspace", "workspacev2", "focusedmon", "focusedmonv2", "openwindow", "closewindow",
          "movewindow", "movewindowv2", "createworkspace", "createworkspacev2", "destroyworkspace",
          "destroyworkspacev2", "urgent", "configreloaded"}


def hyprctl(*args):
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=3).stdout
    try:
        return json.loads(out or "null")
    except ValueError:
        return None


def numerals():
    try:
        return json.loads(PREFS.read_text()).get("numerals", "kanji")
    except (OSError, ValueError):
        return "kanji"


def render(urgent):
    spaces = {w["id"]: w for w in hyprctl("workspaces") or [] if w.get("id", 0) > 0}
    active = (hyprctl("activeworkspace") or {}).get("id")
    kanji = numerals() == "kanji"
    for n in range(1, 11):
        w = spaces.get(n)
        if not w and n > PERSISTENT and n != active:
            line = ""
        else:
            state = ("active" if n == active else "urgent" if n in urgent
                     else "occupied" if w and w.get("windows") else "empty")
            windows = w.get("windows", 0) if w else 0
            line = json.dumps({"text": KANJI[n - 1] if kanji else str(n), "class": state,
                               "tooltip": f"Workspace {n} · {windows} window{'s' * (windows != 1)}"},
                              ensure_ascii=False)
        path = DIR / str(n)
        if not path.exists() or path.read_text() != line:
            path.write_text(line)
    subprocess.run(["pkill", f"-RTMIN+{SIGNAL}", "-x", "waybar"])


def watch():
    DIR.mkdir(parents=True, exist_ok=True)
    try:  # one watcher: a waybar reload starts a new one, the old one leaves
        os.kill(int(PIDFILE.read_text()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    PIDFILE.write_text(str(os.getpid()))
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(str(RUN / "hypr" / sig / ".socket2.sock"))
    urgent = set()
    render(urgent)
    buf = b""
    while True:
        data = sock.recv(4096)
        if not data:
            return
        buf += data
        *lines, buf = buf.split(b"\n")
        changed = False
        for raw in lines:
            event, _, _ = raw.decode(errors="replace").partition(">>")
            if event in EVENTS:
                changed = True
            if event == "urgent":
                # urgent names a window; mark its workspace until you visit it
                addr = raw.decode(errors="replace").partition(">>")[2]
                for c in hyprctl("clients") or []:
                    if c.get("address", "").removeprefix("0x") == addr.removeprefix("0x"):
                        urgent.add(c["workspace"]["id"])
        if changed:
            active = (hyprctl("activeworkspace") or {}).get("id")
            urgent.discard(active)
            render(urgent)
        try:  # an empty line keeps custom/ws-watch hidden and tells us when waybar is gone
            print("", flush=True)
        except BrokenPipeError:
            return


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "watch":
        watch()
    elif arg.isdigit():
        try:
            print((DIR / arg).read_text())
        except OSError:
            print("")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
