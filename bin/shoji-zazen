#!/usr/bin/env python3
"""坐禅 Zazen: a focus session. Silences notifications, hides the bar, dims the windows you are not
in, and hypr-widgets shows a small ensō at the top that closes as the time passes. At the end
everything comes back, one notification says how many came in meanwhile, and a rest (休) follows
with its own quieter ensō and a rest card: one thing to do away from the screen (hypr-widgets picks
it, see shoji_widgets/rest.py). Finished sessions are counted per day (Koyomi shows 座 ×N).

Lengths come from prefs: "zazen" = "FOCUS/REST" minutes ("25/5", "50/10", "90/20"), and every
LONG_EVERY-th rest lasts "zazen_long" minutes (0 = never). The Preferences popover sets both.

  shoji-zazen toggle [MIN]   start (default 25 min), or stop a running session or rest
  shoji-zazen start [MIN] | stop [--done] | status | today
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
STATE = RUN / "shoji-zazen.json"
FIFO = RUN / "hypr-osd.fifo"   # hypr-widgets draws the ensō
DEFAULT_MIN, REST_MIN, LONG_MIN, LONG_EVERY = 25, 5, 15, 4
PREFS = Path.home() / ".config/shoji/prefs.json"
LOG = Path.home() / ".local/state/shoji-zazen.log"   # one line per finished session: date minutes


def lengths():
    """(focus, rest, long rest) minutes from prefs, the defaults where unset or unreadable."""
    try:
        p = json.loads(PREFS.read_text())
    except (OSError, ValueError):
        p = {}
    try:
        focus, rest_ = (int(x) for x in str(p.get("zazen", f"{DEFAULT_MIN}/{REST_MIN}")).split("/"))
    except ValueError:
        focus, rest_ = DEFAULT_MIN, REST_MIN
    try:
        long_ = int(p.get("zazen_long", LONG_MIN))
    except (TypeError, ValueError):
        long_ = LONG_MIN
    return focus, rest_, long_


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def hypr_option(name):
    try:
        v = json.loads(run("hyprctl", "getoption", name, "-j") or "{}")
    except ValueError:
        return None
    return v.get("bool", v.get("int", v.get("float")))


def bar_shown(layers_json=None):
    """Whether waybar is on screen, asked of Hyprland: SIGUSR1 only toggles, so trusting what was
    last sent turns the bar inside out after a waybar restart mid-session. A hidden bar drops to
    the bottom layer (Shoji's bar lives on top). None when no bar is running."""
    try:
        layers = json.loads(layers_json if layers_json is not None else run("hyprctl", "layers", "-j") or "{}")
    except ValueError:
        return None
    levels = [int(lvl) for mon in layers.values() for lvl, ls in mon.get("levels", {}).items()
              for layer in ls if layer.get("namespace") == "waybar"]
    return max(levels) >= 2 if levels else None


def toggle_bar():
    run("pkill", "-SIGUSR1", "-x", "waybar")


def tell_widgets(line):
    if FIFO.is_fifo():
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, (line + "\n").encode())
        finally:
            os.close(fd)


def running():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return None


def start(minutes):
    if running():
        return
    state = {
        "phase": "focus", "start": time.time(), "minutes": minutes,
        "held_from": int(run("swaync-client", "-c") or 0),
        "dnd": run("swaync-client", "-D") == "true",
        "dim": hypr_option("decoration:dim_inactive"),
        "dim_strength": hypr_option("decoration:dim_strength"),
        "bar": bar_shown() is True,   # true: this session hid the bar, so the stop brings it back
    }
    STATE.write_text(json.dumps(state))
    run("swaync-client", "-dn")
    run("hyprctl", "eval", "hl.config({ decoration = { dim_inactive = true, dim_strength = 0.35 } })")
    if state["bar"]:
        toggle_bar()
    tell_widgets("zazen\tstart")


def rest_minutes(done_today):
    _, short, long_ = lengths()
    return long_ if long_ and done_today and done_today % LONG_EVERY == 0 else short


def rest():
    minutes = rest_minutes(today_count())
    STATE.write_text(json.dumps({"phase": "rest", "start": time.time(), "minutes": minutes}))
    tell_widgets("zazen\tstart")
    tell_widgets("rest\tshow")   # the rest card: one thing to do, over a dimmed screen


def today_count():
    try:
        day = time.strftime("%Y-%m-%d")
        return sum(1 for line in LOG.read_text().splitlines() if line.startswith(day))
    except OSError:
        return 0


def stop(done=False):
    state = running()
    if not state:
        return
    STATE.unlink(missing_ok=True)
    tell_widgets("zazen\tstop")
    if state.get("phase") == "rest":
        tell_widgets("rest\thide")
        if done:
            run("notify-send", "-a", "Zazen", "-u", "low", "休 · rest is over", "Super+Z when you are ready for the next one.")
        return
    if not state.get("dnd"):
        run("swaync-client", "-df")
    dim = "true" if state.get("dim") else "false"
    strength = state.get("dim_strength") or 0.5
    run("hyprctl", "eval", f"hl.config({{ decoration = {{ dim_inactive = {dim}, dim_strength = {strength} }} }})")
    if state.get("bar") and bar_shown() is False:
        toggle_bar()
    minutes = round((time.time() - state["start"]) / 60)
    if done:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M')} {state['minutes']}\n")
        held = max(0, int(run("swaync-client", "-c") or 0) - state.get("held_from", 0))
        meanwhile = f"{held} notification{'s' * (held != 1)} came in meanwhile." if held else "Nothing came in meanwhile."
        run("notify-send", "-a", "Zazen", f"坐禅 · done ({today_count()} today)",
            f"{state['minutes']} minutes of focus. {meanwhile} Now {rest_minutes(today_count())} minutes of rest.")
        rest()
    elif minutes:
        run("notify-send", "-a", "Zazen", "-u", "low", "坐禅 · stopped", f"after {minutes} of {state['minutes']} minutes")


def main():
    args = sys.argv[1:] or ["toggle"]
    cmd = args[0]
    minutes = int(args[1]) if len(args) > 1 and args[1].isdigit() else lengths()[0]
    if cmd == "toggle":
        stop() if running() else start(minutes)
    elif cmd == "start":
        start(minutes)
    elif cmd == "stop":
        stop(done="--done" in args)
    elif cmd == "today":
        print(today_count())
    elif cmd == "status":
        state = running()
        if state:
            left = state["minutes"] * 60 - (time.time() - state["start"])
            print(f"{state.get('phase', 'focus')} {max(0, round(left / 60))} min left of {state['minutes']}")
        else:
            print("off")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
