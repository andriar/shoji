#!/usr/bin/env python3
"""Screenshot menu: region / window / screen, copied to the clipboard and saved.

Usage: hypr-shot [menu|region|window|screen|delay]
Files go to ~/Pictures/Screenshots. hypr-widgets shows a preview card in the bottom right (open,
folder, delete); without it, a notification with the picture.
"""
import json
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

DIR = Path.home() / "Pictures/Screenshots"
G = chr
OPTIONS = [
    ("region", f"{G(0xF0A6D)}  Select area"),
    ("window", f"{G(0xF0614)}  Active window"),
    ("screen", f"{G(0xF0379)}  Whole screen"),
    ("delay",  f"{G(0xF051B)}  Whole screen in 3 seconds"),
]


def sh(*cmd, inp=None):
    return subprocess.run(cmd, input=inp, capture_output=True, text=True)


def geometry(mode):
    if mode == "region":
        r = sh("slurp")
        return r.stdout.strip() if r.returncode == 0 else None
    if mode == "window":
        w = json.loads(sh("hyprctl", "activewindow", "-j").stdout or "{}")
        if not w:
            return None
        (x, y), (wd, ht) = w["at"], w["size"]
        return f"{x},{y} {wd}x{ht}"
    return ""


def shoot(mode):
    if mode == "delay":
        time.sleep(3)
        mode = "screen"
    else:
        time.sleep(0.25)  # let the menu / panel fade out first
    geo = geometry(mode)
    if geo is None:
        return
    DIR.mkdir(parents=True, exist_ok=True)
    out = DIR / f"screenshot-{datetime.now():%Y-%m-%d_%H-%M-%S}.png"
    subprocess.run(["grim", *(["-g", geo] if geo else []), str(out)], check=True)
    with open(out, "rb") as f:
        subprocess.run(["wl-copy", "--type", "image/png"], stdin=f)
    if not card(out):
        sh("notify-send", "-a", "Screenshot", "-i", str(out), "Screenshot copied",
           f"Paste with Ctrl+V · saved to ~/Pictures/Screenshots/{out.name}")


def card(path):
    """Hand the shot to hypr-widgets' preview card; False when it is not running."""
    import os
    run = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    try:
        os.kill(int((run / "hypr-widgets.pid").read_text()), 0)
        fd = os.open(run / "hypr-osd.fifo", os.O_WRONLY | os.O_NONBLOCK)
    except (OSError, ValueError):
        return False
    try:
        os.write(fd, f"shot\t{path}\n".encode())
    finally:
        os.close(fd)
    return True


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "menu"
    if mode == "menu":
        choice = sh("fuzzel", "--dmenu", "--index", f"--prompt={G(0xF0E51)}  ",
                    "--placeholder=Screenshot — copied and saved", "--width=40",
                    f"--lines={len(OPTIONS)}", inp="\n".join(label for _, label in OPTIONS)).stdout.strip()
        if not choice.isdigit():
            return
        mode = OPTIONS[int(choice)][0]
    shoot(mode)


if __name__ == "__main__":
    main()
