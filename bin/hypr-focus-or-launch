#!/usr/bin/env python3
"""Focus an app's window if it is open, otherwise start it.

Usage: hypr-focus-or-launch CLASS_REGEX COMMAND [ARGS...]
  CLASS_REGEX  matched (case-insensitive) against each window's class and initial class
  COMMAND      what to run when no window matches, e.g. `gtk-launch com.slack.Slack`
Pressing the key again while the app is focused cycles through its windows.
"""
import json
import re
import subprocess
import sys


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    pattern = re.compile(sys.argv[1], re.I)
    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")
    wins = [c for c in clients if pattern.search(c.get("class", "")) or pattern.search(c.get("initialClass", ""))]
    if not wins:
        subprocess.Popen(sys.argv[2:], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    # most recently used first; if that one already has focus, go to the next one
    wins.sort(key=lambda c: c.get("focusHistoryID", 99))
    target = wins[1] if wins[0].get("focusHistoryID") == 0 and len(wins) > 1 else wins[0]
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{target["address"]}" }})'],
                   stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
