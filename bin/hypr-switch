#!/usr/bin/env python3
"""Alt+Tab: Shoji's window cards when hypr-widgets runs (hold Alt, Tab to move, let go to switch);
otherwise a fuzzel list of every window, most recently used first, the current one last."""
import json
import os
import subprocess
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
try:
    os.kill(int((RUN / "hypr-widgets.pid").read_text()), 0)
    os.execv(str(Path.home() / ".local/bin/hypr-pop"), ["hypr-pop", "switch"])
except (OSError, ValueError):
    pass

def sh(*cmd, inp=None):
    return subprocess.run(cmd, input=inp, capture_output=True, text=True).stdout

wins = [w for w in json.loads(sh("hyprctl", "clients", "-j") or "[]")
        if w.get("mapped") and w["workspace"]["id"] != -1]
wins.sort(key=lambda w: (w["focusHistoryID"] == 0, w["focusHistoryID"]))
if not wins:
    raise SystemExit

rows = []
for w in wins:
    ws = w["workspace"]["name"]
    ws = "S" if ws.startswith("special") else ws
    title = w["title"] or w["class"]
    icon = (w["class"] or "application-x-executable").lower()
    rows.append(f"{ws:>2}  {w['class']} — {title}\0icon\x1f{icon}")

choice = sh("fuzzel", "--dmenu", "--index", "--prompt=󰓡  ", "--placeholder=Switch window",
            "--width=72", f"--lines={min(len(rows), 12)}", inp="\n".join(rows)).strip()
if choice.isdigit():
    addr = wins[int(choice)]["address"]
    sh("hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})')
