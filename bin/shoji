def dep_found(what):
    import shutil
    if what.startswith("py:"):
        lib = what[3:]
        version = {"GtkLayerShell": "0.1", "ECal": "2.0"}[lib]
        return subprocess.run([sys.executable, "-c", f"import gi; gi.require_version('{lib}', '{version}')"],
                              capture_output=True).returncode == 0
    if what == "swaync>=0.10":
        out = subprocess.run(["swaync", "--version"], capture_output=True, text=True).stdout.split()
        try:
            major, minor = (int(x) for x in out[-1].split(".")[:2])
            return (major, minor) >= (0, 10)
        except (IndexError, ValueError):
            return False
    return any(shutil.which(w) or (HOME / ".local/bin" / w).exists() or (HOME / ".cargo/bin" / w).exists()
               for w in what.split("|"))


def cmd_deps():
    missing = 0
    for needed, what, gives in DEPS:
        ok = dep_found(what)
        missing += needed and not ok
        mark = "ok  " if ok else ("MISS" if needed else "–   ")
        print(f"  {mark} {what.removeprefix('py:'):<24} {gives}")
    print("\nAll needed pieces are there." if not missing else f"\n{missing} needed piece(s) missing.")


def cmd_doctor(name):
    t = tokens(name)
    print(f"{PALETTES[name]['name']} on {t['base']}")
    for k in ("text", "muted", "accent", "ok", "alert", "warn", "info"):
        cr = contrast(t[k], t["base"])
        print(f"  {k:<7} {t[k]}  {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    low = [f"{i}" for i, c in enumerate(ansi_colors(name)) if i and contrast(c, t["base"]) < 4.5]
    print(f"  terminal 16 colors  {'pass' if not low else 'FAIL ' + ','.join(low)}")
    on_diff = [c for i, c in enumerate(ansi_colors(name)) if i and not (PALETTES[name]["dark"] and i == 8)]
    cr = min(contrast(c, mix(t["base"], t[k], diff_tint(PALETTES[name]["dark"]))) for k in ("ok", "alert") for c in on_diff)
    print(f"  diff lines (delta)  {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    cr = contrast(t["on_accent"], t["accent"])
    print(f"  on_accent on accent {cr:5.2f}  {'pass' if cr >= 4.5 else 'FAIL'}")
    fonts = subprocess.run(["fc-list", ":", "family"], capture_output=True, text=True).stdout
    for f in ("Kaisei Opti", "Zen Kaku Gothic New", "lucide", "JetBrainsMono Nerd Font"):
        print(f"  font    {f:<24} {'ok' if f in fonts else 'MISSING'}")


GREETER = HOME / ".local/share/shoji/greeter"


def cmd_greeter():
    """Login screen (greetd + ReGreet) in the current palette. Writes files to GREETER only and
    prints the steps that need root: nothing outside your home changes until you run them."""
    import shutil
    try:
        live = json.loads((CFG / "shoji/current.json").read_text())   # with the seasonal accent
        t, dark = live["tokens"], live["dark"]
    except (OSError, ValueError, KeyError):
        t, dark = tokens(current()), PALETTES[current()]["dark"]
    GREETER.mkdir(parents=True, exist_ok=True)
    (GREETER / "regreet.toml").write_text(f"""# ReGreet in Shoji's palette (shoji greeter). Goes to /etc/greetd/regreet.toml
[background]
path = "/etc/greetd/shoji-background.png"
fit = "Cover"

[GTK]
application_prefer_dark_theme = {str(dark).lower()}
font_name = "Zen Kaku Gothic New 13"
icon_theme_name = "Papirus{'-Dark' if dark else ''}"
theme_name = "Adwaita"

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]

[appearance]
greeting_msg = "おかえり"

[widget.clock]
format = "%H:%M"
""")
    (GREETER / "regreet.css").write_text(f"""/* ReGreet in Shoji's palette (shoji greeter). Goes to /etc/greetd/regreet.css */
* {{ font-family: "Zen Kaku Gothic New", sans-serif; }}
window {{ background-color: {t["base"]}; color: {t["text"]}; }}
frame, frame > border {{ background-color: alpha({t["base"]}, 0.86); border: 1px solid {t["surface1"]}; border-radius: 14px; }}
label {{ color: {t["text"]}; }}
label.dim-label, .dim-label {{ color: {t["muted"]}; }}
entry, dropdown > button, combobox > box > button {{
  background-color: {t["surface0"]}; color: {t["text"]};
  border: 1px solid {t["surface1"]}; border-radius: 10px; box-shadow: none; caret-color: {t["accent"]};
}}
entry:focus-within {{ border-color: {t["accent"]}; outline: none; }}
button {{ background-color: {t["surface0"]}; color: {t["text"]}; border: none; border-radius: 10px; box-shadow: none; }}
button:hover {{ background-color: {t["surface1"]}; }}
button.suggested-action {{ background-color: {t["accent"]}; color: {t["on_accent"]}; }}
button.destructive-action {{ background-color: {t["alert"]}; color: {t["base"]}; }}
infobar, .error {{ color: {t["alert"]}; }}
""")
    wall = WALLS / f"shoji-{current()}.png"
    if wall.exists():
        shutil.copyfile(wall, GREETER / "background.png")
    (GREETER / "config.toml").write_text("""# greetd: ReGreet inside cage. Goes to /etc/greetd/config.toml
# user: "greeter" on Arch, "_greetd" on Debian/Ubuntu (the user the greetd package made)
[terminal]
vt = 1

[default_session]
command = "dbus-run-session cage -s -mlast -d -- regreet"
user = "greeter"
""")
    g = GREETER
    print(f"""Wrote the login screen for {current()} to {g}

1. Copy it into place (root; nothing changes at login yet):
   sudo install -Dm644 {g}/regreet.toml {g}/regreet.css -t /etc/greetd/
   sudo install -Dm644 {g}/background.png /etc/greetd/shoji-background.png
   sudo install -d /usr/local/share/fonts/shoji && sudo cp {HOME}/.local/share/fonts/Shoji/*.ttf /usr/local/share/fonts/shoji/ && sudo fc-cache -f

2. Only when you choose to switch the login screen: see docs/greeter.md. It needs greetd, cage
   and regreet, and replaces your current display manager (with the way back written there).""")


def cmd_slack():
    """Slack's custom theme takes four colours: navigation, selected item, presence, notifications.
    Uses the live palette (with the seasonal accent) when there is one."""
    import shutil
    try:
        live = json.loads((CFG / "shoji/current.json").read_text())
        t, dark = live["tokens"], live["dark"]
    except (OSError, ValueError, KeyError):
        t, dark = tokens(current()), PALETTES[current()]["dark"]
    theme = ", ".join(t[k].upper() for k in ("base", "accent", "ok", "alert"))
    copied = False
    if shutil.which("wl-copy"):
        # wl-copy stays behind to serve the clipboard: no pipes, or this would wait on it
        copied = subprocess.run(["wl-copy", theme], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL).returncode == 0
    print(f"""{theme}{"   (copied)" if copied else ""}

Slack → your photo → Preferences → Theme: Color mode {"Dark" if dark else "Light"},
then Custom theme → Theme Colors → Import, paste, Apply.
Slack keeps it until you import another: run this again after a palette change.""")


def main():
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "status":
        print(current())
    elif cmd == "list":
        cur = current()
        for k, p in PALETTES.items():
            print(f"{'●' if k == cur else ' '} {k:<9} {p['kanji']:<3} {p['note']} ({'dark' if p['dark'] else 'light'})")
    elif cmd == "doctor" and "--deps" in args:
        cmd_deps()
    elif cmd == "doctor":
        cmd_doctor(args[1] if len(args) > 1 else current())
    elif cmd == "gnome":
        gnome_reset()
    elif cmd == "vscode":
        write_vscode(current(), tokens(current()))
        install_vscode()
    elif cmd == "spotify":
        if not shutil_which("spicetify"):
            sys.exit("spicetify not found (https://spicetify.app)")
        write_spotify(current())
        run("spicetify", "config", "current_theme", "Shoji", "color_scheme", current())
        print("Shoji is the spicetify theme now: run `spicetify apply` (it restarts Spotify).\n"
              "Every `shoji apply` then sets the matching colour scheme for the next spicetify apply.")
    elif cmd == "slack":
        cmd_slack()
    elif cmd == "chrome":
        write_chrome(current(), tokens(current()))
        print(f"Chrome: chrome://extensions → Developer mode → Load unpacked → {APPS / 'chrome'}\n"
              "After a palette change, press that extension's reload button.")
    elif cmd == "wallpaper":
        set_wallpaper(args[1] if len(args) > 1 else None)
    elif cmd == "date-kanji":
        d = datetime.date.today()
        print(f"{kanji_num(d.month)}月{kanji_num(d.day)}日 · {WEEK_K[d.weekday()]}曜日")
    elif cmd == "senja":  # 夕暮れ: redraw when the sky's tint changes (hypr-widgets asks every 5 min)
        tint = "%s %s" % sky_tint()
        mark = CACHE / "sky-tint"
        try:
            shown = (STATE.parent / "shoji-wallpaper").read_text().strip()
        except OSError:
            shown = ""
        if shown in ("", str(WALLS / f"shoji-{current()}.png")) and (not mark.exists() or mark.read_text() != tint):
            write(mark, tint)
            set_wallpaper(render_wallpaper(current()), transition="fade")
    elif cmd == "moon":  # tonight's phase on the wallpaper (dark palettes; hypr-widgets runs it daily)
        try:
            shown = (STATE.parent / "shoji-wallpaper").read_text().strip()
        except OSError:
            shown = ""
        ours = str(WALLS / f"shoji-{current()}.png")
        if PALETTES[current()]["dark"] and shown in ("", ours):  # never over a wallpaper you picked
            set_wallpaper(render_wallpaper(current()))
    elif cmd == "greet":
        cmd_greet()
    elif cmd == "greeter":
        cmd_greeter()
    elif cmd == "season":
        sid, kanji, colour = season()
        print(f"{sid} {kanji} {colour}")
    elif cmd == "weekday-kanji":
        print(WEEK_K[datetime.date.today().weekday()])
    elif cmd in ("apply", "toggle"):
        quiet = cmd == "apply" and len(args) == 1
        name = current() if quiet else (PALETTES[current()]["pair"] if cmd == "toggle" else args[1])
        if name not in PALETTES:
            sys.exit(f"unknown palette: {name} (shoji list)")
        wall = generate(name)
        reload_apps()
        if not quiet:
            set_wallpaper(wall)
            run("notify-send", "-a", "Shoji", f"{PALETTES[name]['kanji']} {PALETTES[name]['name']}", PALETTES[name]["note"])
            print(name)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
