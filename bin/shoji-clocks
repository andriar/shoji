#!/usr/bin/env python3
"""GNOME Clocks' timers for the island. Clocks shares running timers with nobody (gsettings keeps
only the lengths, D-Bus only alarms), so this reads its window the way a screen reader does
(AT-SPI): each timer's time label and its Start / Pause button, in the Timer page.

  shoji-clocks watch      one JSON line whenever that changes: {"timers": [{"i", "left", "total",
                          "running"}]}, a timer counting only once started (not one at its full
                          length); looks every second while Clocks runs, every 5 s when it does not
  shoji-clocks toggle I   press timer I's Start / Pause button
  shoji-clocks list       the same JSON, once

Clocks has to have its window: a timer left running with the window closed is not seen.
"""
import json
import re
import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi, Gio  # noqa: E402

TIME = re.compile(r"^(\d+):(\d\d):(\d\d)$")


def seconds(label):
    """'00 ∶ 59 ∶ 50' (hair spaces, ratio signs, as Clocks writes it) -> 3590, or None."""
    m = TIME.match(re.sub(r"\s", "", label or "").replace("∶", ":"))
    return int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3]) if m else None


def lengths():
    try:
        return [int(t.get("duration", 0)) for t in Gio.Settings.new("org.gnome.clocks").get_value("timers").unpack()]
    except Exception:   # no Clocks schema
        return []


def rows(labels_buttons, totals):
    """[(label text, button name)] -> what to show: the timers counting down or paused part way."""
    out = []
    for i, (label, button) in enumerate(labels_buttons):
        left = seconds(label)
        if left is None:
            continue
        total = totals[i] if i < len(totals) and totals[i] else left
        running = button not in ("Start", "Resume", "Continue")
        if running or left < total:
            out.append({"i": i, "left": left, "total": max(total, left), "running": running})
    return out


class Clocks:
    """The Timer page's (label, button) pairs, found once and then only re-read."""
    def __init__(self):
        self.pairs, self.found_at = [], 0.0

    def app(self):
        desk = Atspi.get_desktop(0)
        for i in range(desk.get_child_count()):
            a = desk.get_child_at_index(i)
            if a is not None and a.get_name() == "org.gnome.clocks":
                return a
        return None

    def find(self):
        self.pairs, self.found_at = [], time.monotonic()
        app = self.app()
        if app is None:
            return False
        page = []

        def walk(n, depth=0):
            if n is None or depth > 30 or page:
                return
            if n.get_role_name() == "panel" and n.get_name() == "_Timer":
                page.append(n)
                return
            for j in range(n.get_child_count()):
                walk(n.get_child_at_index(j), depth + 1)

        walk(app)
        if not page:
            return False
        labels, buttons = [], []

        def collect(n, depth=0):
            if n is None or depth > 30:
                return
            role, name = n.get_role_name(), n.get_name() or ""
            if role == "label" and seconds(name) is not None:
                labels.append(n)
            elif role == "push button" and name in ("Start", "Pause", "Resume", "Continue"):
                buttons.append(n)
            for j in range(n.get_child_count()):
                collect(n.get_child_at_index(j), depth + 1)

        collect(page[0])
        self.pairs = list(zip(labels, buttons))
        return bool(self.pairs)

    def read(self):
        """[(label, button)] now, or None when Clocks or its window is gone."""
        if not self.pairs or time.monotonic() - self.found_at > 15:   # new timers, a new window
            if not self.find():
                return None
        try:
            return [(lab.get_name(), btn.get_name()) for lab, btn in self.pairs]
        except Exception:   # the window closed under us
            self.pairs = []
            return None


def watch():
    clocks, last = Clocks(), None
    while True:
        got = clocks.read()
        state = {"timers": rows(got, lengths()) if got else []}
        if state != last:
            last = state
            try:
                print(json.dumps(state), flush=True)
            except BrokenPipeError:
                return
        time.sleep(1 if got is not None else 5)


def main(args):
    cmd = args[0] if args else "list"
    if cmd == "watch":
        watch()
    elif cmd == "list":
        got = Clocks().read()
        print(json.dumps({"timers": rows(got, lengths()) if got else []}))
    elif cmd == "toggle" and len(args) > 1 and args[1].isdigit():
        c = Clocks()
        if c.find() and int(args[1]) < len(c.pairs):
            btn = c.pairs[int(args[1])][1]
            btn.get_action_iface().do_action(0)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
