#!/usr/bin/env python3
"""Now playing on the bar: a small cover (image#art) and bars that move while music plays.

  shoji-media watch      custom/media (streaming JSON): ~8 frames a second while playing, one
                         line per change otherwise; keeps the cover rendered and signals image#art
  shoji-media art        image#art: path of the current cover (prints nothing = module hidden)
  shoji-media info       JSON of the current track, for the Media popover
  shoji-media toggle|next|previous

The bars loop the way Spotify's do: decoration while playing, not a spectrum of the audio.
Nothing moves while paused, and the module hides when no player is open.
"""
import hashlib
import json
import math
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "shoji-media"
CURRENT = RUN / "cover"      # holds the path image#art shows
SIGNAL = 13                  # "signal": 13 on image#art
BARS = "▁▂▃▄▅▆▇"
FPS = 8
FIELDS = ["status", "mpris:artUrl", "title", "artist", "album", "mpris:length", "playerName"]


def playerctl(*args):
    try:
        return subprocess.run(["playerctl", *args], capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def track():
    out = playerctl("metadata", "--format", "\t".join("{{%s}}" % f for f in FIELDS))
    values = out.split("\t") if out else []
    if len(values) != len(FIELDS):
        return None
    t = dict(zip(FIELDS, values))
    t["position"] = playerctl("position") or "0"
    return t


def cover_source(url):
    """Local file for an mpris:artUrl (Chrome writes /tmp files, Spotify serves https)."""
    if url.startswith("file://"):
        return Path(urllib.request.url2pathname(url[7:]))
    if url.startswith(("http://", "https://")):
        cache = Path.home() / ".cache/shoji/covers"
        cache.mkdir(parents=True, exist_ok=True)
        path = cache / hashlib.sha1(url.encode()).hexdigest()
        if not path.exists():
            try:
                with urllib.request.urlopen(url, timeout=4) as r:
                    path.write_bytes(r.read())
            except OSError:
                return None
        return path
    return None


def render_cover(src, paused):
    """Square-cropped, rounded 40 px cover (shown at 20); dimmed while paused."""
    import cairo
    import gi
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf
    size, radius = 40, 8
    pix = GdkPixbuf.Pixbuf.new_from_file(str(src))
    side = min(pix.get_width(), pix.get_height())
    pix = pix.new_subpixbuf((pix.get_width() - side) // 2, (pix.get_height() - side) // 2, side, side)
    pix = pix.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
    c = cairo.Context(surface)
    c.new_sub_path()
    for x, y, a in ((size - radius, radius, -math.pi / 2), (size - radius, size - radius, 0),
                    (radius, size - radius, math.pi / 2), (radius, radius, math.pi)):
        c.arc(x, y, radius, a, a + math.pi / 2)
    c.close_path()
    c.clip()
    Gdk.cairo_set_source_pixbuf(c, pix, 0, 0)
    c.paint_with_alpha(0.45 if paused else 1)
    key = hashlib.sha1(f"{src}{src.stat().st_mtime}{paused}".encode()).hexdigest()[:12]
    out = RUN / f"cover-{key}.png"  # a new name per cover: waybar's image module caches by path
    surface.write_to_png(str(out))
    for old in RUN.glob("cover-*.png"):
        if old != out:
            old.unlink(missing_ok=True)
    return out


def set_cover(t):
    path = ""
    if t and t["status"] in ("Playing", "Paused"):
        src = cover_source(t["mpris:artUrl"])
        if src and src.exists():
            try:
                path = str(render_cover(src, t["status"] == "Paused"))
            except Exception as e:  # a cover that does not load must not stop the bar
                print(f"shoji-media: cover: {e}", file=sys.stderr)
    RUN.mkdir(parents=True, exist_ok=True)
    CURRENT.write_text(path)
    subprocess.run(["pkill", f"-RTMIN+{SIGNAL}", "-x", "waybar"])


def bars(t):
    """Four bars, each its own two-sine loop, so the pattern never visibly repeats."""
    out = ""
    for i, (a, b) in enumerate(((5.1, 2.3), (3.7, 6.1), (6.3, 1.9), (4.4, 3.3))):
        v = 0.5 + 0.3 * math.sin(t * a + i * 1.7) + 0.2 * math.sin(t * b + i * 0.6)
        out += BARS[min(len(BARS) - 1, max(0, int(v * len(BARS))))]
    return out


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def watch():
    RUN.mkdir(parents=True, exist_ok=True)
    seen, t, last_poll, start = None, None, 0.0, time.monotonic()
    while True:
        now = time.monotonic()
        if now - last_poll >= 1:
            last_poll = now
            t = track()
            key = (t or {}).get("status"), (t or {}).get("mpris:artUrl"), (t or {}).get("title")
            if key != seen:
                seen = key
                set_cover(t)
        if not t or t["status"] not in ("Playing", "Paused"):
            line = {"text": "", "class": "none"}
        else:
            playing = t["status"] == "Playing"
            tip = esc(t["title"]) + (f"\n{esc(t['artist'])}" if t["artist"] else "")
            line = {"text": bars(now - start) if playing else "▂▂▂▂",
                    "class": "playing" if playing else "paused", "tooltip": tip}
        try:
            print(json.dumps(line, ensure_ascii=False), flush=True)
        except BrokenPipeError:  # waybar went away
            os._exit(0)
        playing = bool(t) and t["status"] == "Playing"
        time.sleep(1 / FPS if playing else 1)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "watch":
        watch()
    elif arg == "art":
        try:
            path = CURRENT.read_text().strip()
        except OSError:
            path = ""
        if path and Path(path).exists():
            print(path)
    elif arg == "info":
        print(json.dumps(track() or {}, ensure_ascii=False))
    elif arg in ("toggle", "next", "previous"):
        playerctl({"toggle": "play-pause"}.get(arg, arg))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
