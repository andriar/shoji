#!/usr/bin/env bash
# Bar clock: time in Kaisei Opti + weekday in kanji (waybar custom module, JSON).
wd=$(~/.local/bin/shoji weekday-kanji)
printf '{"text":"<span font_family=\\"Kaisei Opti\\" weight=\\"bold\\" size=\\"11.5pt\\">%s</span>  <span font_family=\\"Kaisei Opti\\" size=\\"10pt\\" alpha=\\"70%%\\">%s</span>","tooltip":"%s"}\n' \
  "$(date +%H:%M)" "$wd" "$(date '+%A, %-d %B %Y')\nClick: calendar, quick settings, notifications"
