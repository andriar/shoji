#!/usr/bin/env python3
"""Battery of connected Bluetooth devices for waybar (custom/btbat), shown only when one runs low.

Kanso, like the other readings: nothing while every connected device has more than LOW percent;
then the device's icon and its percentage, in the alert colour from CRITICAL down. Click opens the
Bluetooth popover. BlueZ reports the battery for most headphones (Battery Percentage).
"""
import json
import subprocess

LOW, CRITICAL = 20, 10
ICONS = {"audio-headset": "headphones", "audio-headphones": "headphones", "input-mouse": "mouse",
         "input-keyboard": "keyboard", "input-gaming": "gamepad-2", "phone": "smartphone"}


def sh(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def lowest():
    worst = None
    for line in sh("bluetoothctl", "devices", "Connected").splitlines():
        parts = line.split(" ", 2)
        if len(parts) < 3:
            continue
        info = dict(l.strip().split(": ", 1) for l in sh("bluetoothctl", "info", parts[1]).splitlines() if ": " in l)
        pct = info.get("Battery Percentage", "")
        if "(" not in pct:
            continue
        pct = int(pct.rsplit("(", 1)[-1].rstrip(")"))
        if worst is None or pct < worst[0]:
            worst = (pct, info.get("Alias") or parts[2], info.get("Icon", ""))
    return worst


def lucide(name):
    from pathlib import Path
    info = json.loads((Path.home() / ".local/share/fonts/Shoji/lucide-info.json").read_text())
    return chr(int(info[name]["encodedCode"].lstrip("\\"), 16))


def main():
    worst = lowest()
    if not worst or worst[0] > LOW:
        print(json.dumps({"text": "", "class": "ok"}))
        return
    pct, name, kind = worst
    print(json.dumps({"text": f"{lucide(ICONS.get(kind, 'bluetooth'))} {pct}%", "tooltip": f"{name} · {pct}%",
                      "class": "critical" if pct <= CRITICAL else "low"}, ensure_ascii=False))


if __name__ == "__main__":
    main()
