#!/usr/bin/env python3
"""Open an app from a bar click, or close it if it is already open (click again = close).

Usage: hypr-toggle-app CLASS_REGEX COMMAND...
"""
import json
import re
import subprocess
import sys

pattern, cmd = re.compile(sys.argv[1]), sys.argv[2:]
clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
open_wins = [c for c in clients if pattern.fullmatch(c["class"])]
if open_wins:
    for c in open_wins:
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{c["address"]}" }})'],
                       capture_output=True)
else:
    subprocess.Popen(["setsid", "-f", *cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
