#!/usr/bin/env python3
"""Now playing on the bar: the track title, with bars that move while music plays.

  shoji-media watch      custom/media (streaming JSON): one line whenever the track or its state
                         changes. The bars are drawn and animated by the bar's own CSS (class
                         "playing" runs the animation), so nothing here runs per frame; class
                         "hue-N" (24 hues, or "hue-grey") tints them with the cover's colour.
  shoji-media info       JSON of the current track for the Media popover (fetches https covers)
  shoji-media toggle|next|previous|position [SECONDS]

With several players open (a browser and Spotify), the one playing wins, then a paused one.

The bars loop the way Spotify's do: decoration while playing, not a spectrum of the audio.
The module hides when no player is open.
"""
import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

COVERS = Path.home() / ".cache/shoji/covers"
FIELDS = ["status", "mpris:artUrl", "title", "artist", "album", "mpris:length", "playerName"]


def playerctl(*args):
    try:
        return subprocess.run(["playerctl", *args], capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def player(previous=None):
    """The player to show: a playing one (the one already shown, if it still plays), else a
    paused one. Plain `playerctl` would take whichever registered first."""
    names = playerctl("-l").splitlines()
    status = {n: playerctl("-p", n, "status") for n in names}
    for wanted in ("Playing", "Paused"):
        if status.get(previous) == wanted:
            return previous
        for n in names:
            if status[n] == wanted:
                return n
    return None


def track(name=None):
    name = name or player()
    if not name:
        return None
    out = playerctl("-p", name, "metadata", "--format", "\t".join("{{%s}}" % f for f in FIELDS))
    values = out.split("\t") if out else []
    if len(values) != len(FIELDS):
        return None
    t = dict(zip(FIELDS, values))
    t["player"] = name
    t["position"] = playerctl("-p", name, "position") or "0"
    return t


def fetch_cover(url):
    """Spotify serves covers over https: cache them where the popover looks (sha1 of the URL)."""
    if not url.startswith(("http://", "https://")):
        return
    path = COVERS / hashlib.sha1(url.encode()).hexdigest()
    if path.exists():
        return
    COVERS.mkdir(parents=True, exist_ok=True)
    try:
        with urllib.request.urlopen(url, timeout=4) as r:
            path.write_bytes(r.read())
    except OSError:
        pass


def cover_path(url):
    if url.startswith("file://"):
        return Path(urllib.request.url2pathname(url[7:]))
    fetch_cover(url)
    return COVERS / hashlib.sha1(url.encode()).hexdigest()


def hue_class(url, cache={}):
    """The cover's most vivid colour as one of 24 hue classes; "hue-grey" for grey covers.
    Same weighting as the Media popover's colour wash."""
    if url in cache:
        return cache[url]
    result = None
    try:
        import colorsys
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pix = GdkPixbuf.Pixbuf.new_from_file(str(cover_path(url))).scale_simple(
            24, 24, GdkPixbuf.InterpType.BILINEAR)
        data, n, stride = pix.get_pixels(), pix.get_n_channels(), pix.get_rowstride()
        acc, total = [0.0, 0.0, 0.0], 0.0
        for y in range(24):
            for x in range(24):
                r, g, b = (data[y * stride + x * n + i] / 255 for i in range(3))
                w = (max(r, g, b) - min(r, g, b)) * max(r, g, b) + 0.02
                acc = [acc[0] + r * w, acc[1] + g * w, acc[2] + b * w]
                total += w
        h, sat, _ = colorsys.rgb_to_hsv(*(c / total for c in acc))
        result = "hue-grey" if sat < 0.12 else f"hue-{round(h * 24) % 24}"
    except Exception:  # no cover, or one that does not load: the bars keep the accent
        pass
    cache[url] = result
    return result


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def watch():
    last, name = None, None
    while True:
        name = player(name)
        t = track(name) if name else None
        if not t or t["status"] not in ("Playing", "Paused"):
            line = {"text": "", "class": "none"}
        else:
            tip = esc(t["title"]) + (f"\n{esc(t['artist'])}" if t["artist"] else "")
            playing = t["status"] == "Playing"
            hue = hue_class(t["mpris:artUrl"]) if playing and t["mpris:artUrl"] else None
            line = {"text": esc(t["title"] or "Unknown"), "tooltip": tip,
                    "class": ["playing", hue] if hue else "playing" if playing else "paused"}
        if line != last:
            last = line
            try:
                print(json.dumps(line, ensure_ascii=False), flush=True)
            except BrokenPipeError:  # waybar went away
                os._exit(0)
        time.sleep(1)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "watch":
        watch()
    elif arg == "info":
        t = track() or {}
        fetch_cover(t.get("mpris:artUrl", ""))
        print(json.dumps(t, ensure_ascii=False))
    elif arg in ("toggle", "next", "previous", "position"):
        name = player()
        if name:
            playerctl("-p", name, {"toggle": "play-pause"}.get(arg, arg), *sys.argv[2:3])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
