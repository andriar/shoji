def apply_gtk(name, t):
    """GTK 3/4 look. ~/.config/gtk-* is shared with GNOME; `shoji gnome` undoes this there."""
    dark = PALETTES[name]["dark"]
    icons = "Shoji" if ICON_THEME.exists() else ("Papirus-Dark" if dark else "Papirus")
    run("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Adwaita-dark" if dark else "Adwaita")
    run("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark" if dark else "prefer-light")
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icons)
    run("gsettings", "set", "org.gnome.desktop.interface", "font-name", "Zen Kaku Gothic New 11")
    run("gsettings", "set", "org.gnome.desktop.interface", "document-font-name", "Zen Kaku Gothic New 11")
    named = {
        "accent_color": t["accent"], "accent_bg_color": t["accent"], "accent_fg_color": t["on_accent"],
        "window_bg_color": t["base"], "window_fg_color": t["text"],
        "view_bg_color": t["mantle"] if dark else "#ffffff", "view_fg_color": t["text"],
        "headerbar_bg_color": t["base"], "headerbar_fg_color": t["text"], "headerbar_backdrop_color": t["base"],
        "sidebar_bg_color": t["mantle"], "sidebar_fg_color": t["text"], "secondary_sidebar_bg_color": t["mantle"],
        "card_bg_color": rgba(t["text"], 0.05), "card_fg_color": t["text"],
        "popover_bg_color": t["surface0"], "popover_fg_color": t["text"],
        "dialog_bg_color": t["surface0"], "dialog_fg_color": t["text"],
        "destructive_bg_color": t["alert"], "destructive_color": t["alert"],
        "success_color": t["ok"], "warning_color": t["warn"], "error_color": t["alert"],
        # GTK3 Adwaita names
        "theme_bg_color": t["base"], "theme_fg_color": t["text"], "theme_base_color": t["mantle"] if dark else "#ffffff",
        # GTK3 apps paint selections with these: a tint of the accent keeps the file name readable
        "theme_text_color": t["text"], "theme_selected_fg_color": t["text"],
        "theme_selected_bg_color": mix(t["base"], t["accent"], 0.30 if dark else 0.24),
        "insensitive_fg_color": t["overlay0"], "borders": t["surface1"],
        "shoji_muted": t["muted"], "shoji_surface": rgba(t["text"], 0.06), "shoji_hover": rgba(t["text"], 0.10),
        "shoji_edge": rgba(t["text"], 0.14),
    }
    gtkcss = "/* Generated by shoji — GNOME logins remove this file (shoji gnome) */\n" + "".join(
        f"@define-color {k} {v};\n" for k, v in named.items())
    for ver in ("gtk-3.0", "gtk-4.0"):
        for fname in ("gtk.css", "gtk-dark.css") if ver == "gtk-4.0" else ("gtk.css",):
            f = CFG / ver / fname
            if f.is_symlink():
                f.unlink()
            write(f, gtkcss + (GTK3_CSS if ver == "gtk-3.0" else ""))
        write(CFG / ver / "settings.ini", f"[Settings]\ngtk-application-prefer-dark-theme={int(dark)}\n"
              f"gtk-icon-theme-name={icons}\ngtk-font-name=Zen Kaku Gothic New 11\n"
              + (f"gtk-cursor-theme-name={CURSOR}\ngtk-cursor-theme-size=24\n" if cursor_installed() else ""))
    assets = CFG / "gtk-4.0/assets"
    if assets.is_symlink():
        assets.unlink()


