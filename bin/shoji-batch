#!/usr/bin/env python3
"""通 Notifications in batches (prefs "batch": 30 or 60 minutes; 0 = as they come).

swaync runs `shoji-batch note` for every notification (its config gets the script while batches
are on). Critical ones are not noted: they come through at once. hypr-widgets keeps Silent on and,
every 30 or 60 minutes, shows one card with what waited, by app; then the log starts again.

  shoji-batch note      append the notification's app (from swaync's SWAYNC_* variables)
  shoji-batch list      what waits, by app
"""
import collections
import os
import sys
import time
from pathlib import Path

LOG = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "shoji-batch.log"


def waiting():
    try:
        apps = [line.split("\t", 1)[1] for line in LOG.read_text().splitlines() if "\t" in line]
    except OSError:
        return collections.Counter()
    return collections.Counter(a or "?" for a in apps)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "note":
        if os.environ.get("SWAYNC_URGENCY", "").lower() == "critical":
            return
        app = os.environ.get("SWAYNC_APP_NAME", "").replace("\t", " ").replace("\n", " ")
        with LOG.open("a") as f:
            f.write(f"{int(time.time())}\t{app}\n")
    elif cmd == "list":
        for app, n in waiting().most_common():
            print(f"{n:>3}  {app}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
