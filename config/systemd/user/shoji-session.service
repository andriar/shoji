# Shoji's shell for one Hyprland session. Started by `shoji-session start` from Hyprland's
# autostart; it ends with that Hyprland and takes the units below with it.
[Unit]
Description=Shoji shell for this Hyprland session
Documentation=https://github.com/andriar/shoji
Wants=shoji-notify.service shoji-bar.service shoji-widgets.service shoji-watchdog.service

[Service]
Type=simple
ExecStart=%h/.local/bin/shoji-session anchor
